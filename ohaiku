    def place(self):
        f = int(self.t * 5) % 8
        bob = -6 * abs(math.sin(self.t * 5 * math.pi / 4))
        self.win.move(int(self.x - self.cell / 2), int(self.app.floor() + LABEL_H - self.foot + bob))

    def tick(self, dt):
        self.t += dt; self.x += self.dir * 110 * dt; self.place()
        f = int(self.t * 5) % 8
        if f != self.shown: self.shown = f; self.win.queue_draw()
        if (self.x - self.end) * self.dir > 0: self.win.destroy(); return False
        return True

    def draw(self, w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE); cr.set_source_rgba(0, 0, 0, 0); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER)
        cr.set_source_surface(self.img, -(self.shown or 0) * self.cell, 0); cr.rectangle(0, 0, self.cell, self.cell); cr.fill()
        return True


class Bounce:
    """rarely: a free one becomes the DVD logo, drifting round the screen and changing colour at every wall, while
    everyone waits for it to hit a corner exactly. It always does: its path is worked out backwards from one"""
    COLOURS = [(.93, .27, .3), (.25, .62, .95), (.98, .78, .16), (.56, .38, .93), (.3, .8, .42), (.97, .45, .75), (1, .55, .15)]

    def __init__(self, app, c):
        self.app, self.c, self.t, self.hit, self.alpha = app, c, 0.0, None, 1.0
