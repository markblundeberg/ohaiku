        wa = self.app.workarea(); x0, y0 = wa.x + 24, wa.y + 40
        for dx, dy in ((-2, 0), (2, 0), (0, -2), (0, 2)): cr.move_to(x0 + dx, y0 + dy); cr.set_source_rgb(0, .12, 0); cr.show_text(txt)
        cr.move_to(x0, y0); cr.set_source_rgb(.2, .95, .25); cr.show_text(txt)
        if hint:
            cr.set_font_size(13); cr.move_to(x0, y0 + 22); cr.set_source_rgba(0, .3, 0, .9); cr.show_text(hint)
        return True


class Theater:
    """Movie night: the pets' own window, playing our films on mute (after MST3K, they sit in a row in front of it)"""

    def __init__(self, app, x, y):
        self.app, self.t = app, 0.0
        root = os.path.join(SHARE, 'tv')
        self.reels = sorted(d for d in os.listdir(root) if os.path.isdir(os.path.join(root, d))) if os.path.isdir(root) else []
        random.shuffle(self.reels)
        self.ri, self.frames, self.shown, self.pix = 0, [], None, None
        w = self.win = Gtk.Window(title='Haiku Theater 3000')
        w.set_accept_focus(False); w.set_focus_on_map(False)
        self.area = Gtk.DrawingArea(); self.area.set_size_request(448, 252); w.add(self.area)
        self.area.connect('draw', self.draw)
        w.connect('delete-event', lambda *_: (app.theater_closed(), False)[1])
        w.move(int(x), int(y))
        self.load()
        if not app.hidden and not app.locked: self.show()

    def show(self):
        # opened without taking focus, so the window manager would tuck it under your active window; put it on top
        # (raise_() is ignored for a window that never had focus; a moment of keep-above lifts it without focus)
        self.win.show_all()
        self.win.set_keep_above(True)
        GLib.timeout_add(400, lambda: (self.win.set_keep_above(False), False)[1])

    def load(self):
        if not self.reels: self.frames = []; return
        name = self.reels[self.ri % len(self.reels)]
        d = os.path.join(SHARE, 'tv', name)
        self.frames = sorted(os.path.join(d, f) for f in os.listdir(d))
        self.win.set_title('Haiku Theater 3000 \u2014 %s.mp4 (muted)' % name)
        self.t = 0.0

    def tick(self, dt):
        self.t += dt
        if not self.frames: return
        f = int(self.t * 12)
        if f >= len(self.frames):
            self.ri += 1; self.load(); f = 0
        if f != self.shown:
            self.shown = f
            try: self.pix = GdkPixbuf.Pixbuf.new_from_file(self.frames[f])
            except Exception: self.pix = None
            self.area.queue_draw()

    def draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        cr.set_source_rgb(0, 0, 0); cr.paint()
        if self.pix:
            k = min(W / self.pix.get_width(), H / self.pix.get_height())
            cr.translate((W - self.pix.get_width() * k) / 2, (H - self.pix.get_height() * k) / 2); cr.scale(k, k)
            Gdk.cairo_set_source_pixbuf(cr, self.pix, 0, 0); cr.paint()
        return True

    def seats(self, n):
        gw = self.area.get_window()
        if gw is None: return None
        o = gw.get_origin(); ox, oy = (o[1], o[2]) if len(o) == 3 else o
        W, H = self.area.get_allocated_width(), self.area.get_allocated_height()
        return [(ox + W * (i + .5) / n, oy + H + 6) for i in range(n)]


