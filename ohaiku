            cr.save(); cr.translate(ex + sd * 44, ey + 2); cr.rotate(sd * op * 1.35)
            cr.rectangle(-22 if sd > 0 else 0, 0, 22, 5); cr.fill(); cr.restore()
        xx, fy = G['exit']                                                                                   # the doorway
        cr.set_source_rgb(.42, .27, .15); cr.new_path(); cr.arc(xx, fy - 52, 26, math.pi, 0); cr.line_to(xx + 26, fy); cr.line_to(xx - 26, fy); cr.close_path(); cr.fill()
        cr.set_source_rgb(.12, .08, .06); cr.new_path(); cr.arc(xx, fy - 50, 18, math.pi, 0); cr.line_to(xx + 18, fy); cr.line_to(xx - 18, fy); cr.close_path(); cr.fill()
        for k in range(12):
            a = k / 12 * 6.283; cr.set_source_rgb(.99, .78, .2); cr.arc(xx + 15 * math.cos(a), fy - 86 + 15 * math.sin(a), 7, 0, 6.3); cr.fill()
        cr.set_source_rgb(.45, .26, .12); cr.arc(xx, fy - 86, 9, 0, 6.3); cr.fill()
        for b in G['bricks']:                                                                                # Q.E.D. bricks
            cr.set_source_rgb(.82, .48, .33); cr.rectangle(b.x0, b.y, b.x1 - b.x0, 6); cr.fill()
            cr.set_source_rgba(.77, .16, .23, .9); cr.set_line_width(1); cr.rectangle(b.x0 + 6, b.y + 1.5, b.x1 - b.x0 - 12, 3); cr.stroke()
        txt = 'OUT %d  IN %d  SAVED %d%%' % (G['out'], G['saved'], 100 * G['saved'] // G['n'])
        hint = 'click: build   middle-click: float   right-click: block' if G['t'] < 25 else ''
