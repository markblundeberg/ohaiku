class Cascade:
    """Windows Solitaire's win: a chibi that just finished a long stretch of work bounces off across the screen,
    leaving a copy of itself every frame on a canvas that is never cleared"""

    def __init__(self, app, c):
        self.app, self.c, self.t, self.alpha = app, c, 0.0, 1.0
        self.ov = Overlay(app, self.draw)
        self.can = cairo.ImageSurface(cairo.FORMAT_ARGB32, self.ov.W, self.ov.H)
        self.img = Strips.get(c.who, 'done'); self.cell = c.m['cell']; self.sc = c.sc
        self.x, self.y = c.x - c.cpx / 2, c.y - c.foot
        wa = app.workarea()
        self.vx = (-1 if c.x > wa.x + wa.width / 2 else 1) * random.uniform(220, 380)
        self.vy = -random.uniform(500, 800); self.floor = app.floor() - c.foot; self.done = False
        c.win.hide(); app.balloon(c, 'Done!', '', 1.0)

    def tick(self, dt):
        self.t += dt
        if not self.done:
            self.vy += 1900 * dt; self.x += self.vx * dt; self.y += self.vy * dt
            if self.y > self.floor: self.y = self.floor; self.vy *= -.82
            cr = cairo.Context(self.can)
            cr.translate(self.x, self.y); cr.scale(self.sc, self.sc)
            f = int(self.t * 13.33) % 16
            cr.set_source_surface(self.img, -f * self.cell, 0); cr.rectangle(0, 0, self.cell, self.cell); cr.fill()
            if self.x < -200 or self.x > self.ov.W + 50: self.done, self.t = True, 0.0
        else:
            self.alpha = max(0, 1 - max(0, self.t - 1.5))
            if self.alpha <= 0:
                self.ov.win.destroy()
                if not self.c.gone and not self.app.hidden: self.c.win.show_all()
                return False
        self.ov.win.queue_draw()
        return True

    def draw(self, w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE); cr.set_source_rgba(0, 0, 0, 0); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER)
        cr.set_source_surface(self.can, 0, 0); cr.paint_with_alpha(self.alpha)
        return True


class Flyer:
    """After Dark's Flying Toasters, but Haikus with petal wings: the screensaver"""

    def __init__(self, app, who, x, y, sc):
        self.app, self.x, self.y, self.t = app, x, y, random.uniform(0, 1)
        self.sc = sc; self.img = Strips.get(who, 'fly'); self.cell = Strips.info(who)['cell']; self.px = int(self.cell * sc)
        self.vx, self.vy = -random.uniform(90, 130) * sc, random.uniform(45, 70) * sc
        self.leaving, self.shown = False, None
        w = self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
        w.set_app_paintable(True)
        vis = w.get_screen().get_rgba_visual()
        if vis: w.set_visual(vis)
        w.resize(self.px, self.px)
        w.connect('draw', self.draw)
        w.connect('realize', lambda *_: w.input_shape_combine_region(cairo.Region()))
        w.move(int(x), int(y))
        if not app.hidden and not app.locked: w.show_all()

    def tick(self, dt, W, H):
        self.t += dt
        k = 6 if self.leaving else 1
        self.x += self.vx * dt * k; self.y += self.vy * dt * k
        if self.x < -self.px or self.y > H:
            if self.leaving: self.win.destroy(); return False
            if random.random() < .5: self.x, self.y = W + random.uniform(0, 200), random.uniform(-self.px, H * .5)
            else: self.x, self.y = random.uniform(W * .3, W + 200), -self.px - random.uniform(0, 200)
        self.win.move(int(self.x), int(self.y))
        f = int(self.t * 12) % 8
        if f != self.shown: self.shown = f; self.win.queue_draw()
        return True

    def draw(self, w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE); cr.set_source_rgba(0, 0, 0, 0); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER)
        cr.scale(self.sc, self.sc); cr.set_source_surface(self.img, -(self.shown or 0) * self.cell, 0)
        cr.get_source().set_filter(cairo.FILTER_GOOD); cr.rectangle(0, 0, self.cell, self.cell); cr.fill()
        return True


class Kaiju:
    """very rarely: chibi Opus, five times the size, stomps along the bottom of the screen while everyone hides"""

    def __init__(self, app, who='opus0'):
        self.app, self.t = app, 0.0
        root = os.path.join(SHARE, 'kaiju')
        self.meta = json.load(open(os.path.join(root, 'sheets.json')))[who]
        wa = app.workarea()
        self.dir = random.choice((-1, 1))
        self.img = cairo.ImageSurface.create_from_png(os.path.join(root, who, ('runR' if self.dir > 0 else 'runL') + '.png'))
        self.cell = self.meta['cell']; self.foot = self.meta['foot'][1]
        self.x = wa.x - self.cell / 2 if self.dir > 0 else wa.x + wa.width + self.cell / 2
        self.end = wa.x + wa.width + self.cell / 2 if self.dir > 0 else wa.x - self.cell / 2
        self.shown = None
        w = self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
