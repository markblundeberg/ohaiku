#!/usr/bin/env python3
"""ohaiku — Haiku 5.5 on your desktop. After oneko (Masayuki Koba, 1989), xneko, and Plus! Dancer (2003).

  ohaiku              start, and load up a Haiku (if already running: load up another, with a ding)
  ohaiku --agents     start with just the agents (for autostart)
  ohaiku -n 5         load up five
  ohaiku --opus       load up a chibi Opus
  ohaiku --perch      everyone on the bottom edge, out of the way (the default)
  ohaiku --follow     everyone chases the pointer in a line (oneko); --play does the same
  ohaiku --recess     they play on your windows: climb onto title bars, hop between them, ride along, fall off
  ohaiku --studying   "Nothing! Studying!": everyone vacuumed into the tray (also: shake the mouse)
  ohaiku --hide       vanish (they keep watching); --show to come back; --toggle for a hotkey
  ohaiku --quiet      no ding;  --scale 1.3  bigger (when starting)
  ohaiku --quit       Haikus, go home;  --restart  go home and come back (agents only)

Every Claude Code session on this machine that was active in the last two hours gets a chibi of its own model, with
its name on a little plate, standing on the bottom edge of the screen and acting out what it's doing: reading, searching
(magnifying glass), editing (the Q.E.D. stamp), running commands (the drum), thinking (a thought cloud), sending out
subagents (seed packets; the subagents appear beside it), asking you something (waving a "?"), done (a happy bounce),
and asleep after twenty quiet minutes. Free ones wander and play, and dance when music is playing. Bring the pointer
near and they duck below the edge so only their hoods peek out. Click a name plate (or a chibi waving "?") to go to
that session's terminal window; middle-click a plate to send that one away until its session wants you again; right-click
for the menu. Middle-click the tray icon to hide or show everyone.

X11 with a compositor. Every window is click-through.
"""
import argparse, array, json, math, os, random, signal, subprocess, sys, threading, time

HERE = os.path.dirname(os.path.realpath(__file__))
SHARE = os.path.join(HERE, 'share')
_RUN = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'), 'ohaiku%s' % os.environ.get('DISPLAY', '').replace(':', '-'))
PIDF, CMDF = _RUN + '.pid', _RUN + '.cmd'
UNKNOWN = os.path.expanduser('~/.cache/ohaiku/unknown-tools.txt')
HZ = 30
LABEL_H = 17

# what each tool looks like; anything not here gets 'busy' and is noted in UNKNOWN, so a new drawing can be made for it
TOOL_POSE = {
    'Bash': 'bash', 'BashOutput': 'bash', 'KillShell': 'bash', 'Monitor': 'bash', 'TaskStop': 'bash',
    'Read': 'read', 'NotebookRead': 'read', 'WebFetch': 'read', 'Skill': 'read', 'ReadNotifications': 'read',
    'Grep': 'search', 'Glob': 'search', 'WebSearch': 'search', 'ToolSearch': 'search', 'ListAgents': 'search',
    'Edit': 'edit', 'Write': 'edit', 'MultiEdit': 'edit', 'NotebookEdit': 'edit', 'Artifact': 'edit',
    'Agent': 'agents', 'Task': 'agents', 'Workflow': 'agents', 'SendMessage': 'agents',
    'TodoWrite': 'think', 'EnterPlanMode': 'think',
    'AskUserQuestion': 'ask', 'ExitPlanMode': 'ask', 'PushNotification': 'ask',
}
TOOL_PREFIX = {'mcp__': 'search'}
WORK = {'think', 'ask', 'done', 'bash', 'read', 'search', 'edit', 'agents', 'busy'}


def running_pid():
    try:
        pid = int(open(PIDF).read())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


class Strips:
    meta, surf = None, {}

    @classmethod
    def info(cls, who):
        if cls.meta is None: cls.meta = json.load(open(os.path.join(SHARE, 'sheets.json')))
        return cls.meta[who]

    @classmethod
    def get(cls, who, state):
        k = (who, state)
        if k not in cls.surf: cls.surf[k] = cairo.ImageSurface.create_from_png(os.path.join(SHARE, who, state + '.png'))
        return cls.surf[k]


class Chibi:
    """one character: a pet (loaded up by hand) or an agent (a Claude Code session or subagent)"""

    def __init__(self, app, who, x, y, agent=None, scale=1.0, label=None):
        self.app, self.who, self.agent, self.label = app, who, agent, label
        self.m = Strips.info(who)
        self.sc = scale * app.scale
        self.cpx = int(self.m['cell'] * self.sc)
        self.x, self.y = x, y
        self.heading = random.choice((-1, 1))
        self.state, self.t, self.rest, self.extra, self.rev = 'spawn', 0.0, 0.0, None, False
        self.speed = 400 * self.sc
        self.slot = x
        self.wander = 0.0; self.wander_at = random.uniform(6, 14)
        self.duck = 0.0
        self.shown, self.gone = None, False
        self.shrink, self.spin = 1.0, 0.0                 # the vacuum ("Nothing! Studying!")
        self.on, self.off, self.arc, self.vy, self.falling = None, 0.0, None, 0.0, False   # recess: which window top
        self.next_hop, self.goal, self.settled = None, None, False
        self.W = self.cpx + 40 if label else self.cpx
        self.H = self.cpx + (LABEL_H if label else 0)
        w = self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
        w.set_app_paintable(True)
        vis = w.get_screen().get_rgba_visual()
        if vis: w.set_visual(vis)
        w.set_default_size(self.W, self.H); w.resize(self.W, self.H)
        w.set_accept_focus(False)
        w.connect('draw', self.draw)
        w.connect('realize', lambda *_: self.shape_input())
        w.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        w.connect('button-press-event', self.clicked)
        self.place()
        if not app.hidden: w.show_all()

    @property
    def foot(self): return self.m['foot'][1] * self.sc

    # -- the name plate: the only part that takes clicks ------------------------------------------------
    def plate(self):
        if getattr(self, '_plate', None): return self._plate
        cr = cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 4, 4))
        cr.select_font_face('Sans', cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        fs = 10 if (self.agent and self.agent.kind == 'sub') else 11.5
        cr.set_font_size(fs)
        txt = self.label if len(self.label) <= 18 else self.label[:17] + '…'
        e = cr.text_extents(txt)
        while e.x_advance + 12 > self.W - 2 and len(txt) > 4:
            txt = txt[:-2] + '…'; e = cr.text_extents(txt)
        pw, ph = e.x_advance + 12, LABEL_H - 3
        self._plate = dict(txt=txt, fs=fs, tw=e.x_advance, th=e.height, x=(self.W - pw) / 2, y=self.foot + 1, w=pw, h=ph)
        return self._plate

    def shape_input(self):
        if not self.label: self.win.input_shape_combine_region(cairo.Region()); return    # pets: click-through
        P = self.plate(); reg = cairo.Region(cairo.RectangleInt(int(P['x']), int(P['y']), int(P['w']) + 1, int(P['h']) + 1))
        self.calling = bool(self.agent and self.agent.state == 'ask')
        if self.calling:          # waving at you: the whole chibi is a button
            reg.union(cairo.RectangleInt(int(self.W / 2 - self.cpx * .3), int(self.foot - self.cpx * .8), int(self.cpx * .6), int(self.cpx * .8)))
        self.win.input_shape_combine_region(reg)

    def clicked(self, w, ev):
        if ev.button == 1: self.app.focus(self)
        elif ev.button == 2: self.app.dismiss(self)
        elif ev.button == 3: self.app.agent_menu(self).popup_at_pointer(ev)
        return True

    # -- what it would like to be doing when it isn't running somewhere --------------------------------
    def work(self):
        a = self.agent
        if a is None: return None
        if a.state == 'think': return 'think'
        if a.state == 'ask': return 'ask'
        if a.state == 'done': return 'done'
        if a.state == 'asleep': return 'sleep' if self.app.mode == 'perch' else None    # playtime wakes everyone
        if a.state == 'tool':
            p = TOOL_POSE.get(a.tool)
            if p is None:
                p = next((v for k, v in TOOL_PREFIX.items() if (a.tool or '').startswith(k)), 'busy')
                self.app.note_unknown(a.tool)
            return p
        return None                                             # free

    def set(self, state, rev=False):
        if state != self.state or rev != self.rev: self.state, self.t, self.rev = state, 0.0, rev

    def info(self, state=None):
        return self.m['states'][state or self.state]

    def done_anim(self):
        st = self.info(); return not st['loop'] and self.t * st['fps'] >= st['n']

    def leave(self):
        if not (self.state == 'spawn' and self.rev): self.set('spawn', rev=True)

    def step(self, dt, tx, ty):
        self.t += dt
        s = self.state
        if s == 'spawn':
            if self.done_anim():
                if self.rev: self.gone = True; return
                self.set('idle')
            return
        dx, dy = tx - self.x, ty - self.y
        d = math.hypot(dx, dy)
        want = self.work()
        if s == 'sleep':
            if want != 'sleep' and (want is not None or d > 40 * self.sc or self.agent is None or self.app.mode == 'recess'): self.set('wake')
            return
        if s == 'wake':
            if self.done_anim(): self.set('alert')
            return
        if s == 'alert':
            if self.done_anim() and self.t > .45: self.set('idle')
            return
        if s == 'yawn':
            if d > 30 * self.sc or want not in (None, 'sleep'): self.set('alert')
            elif self.done_anim(): self.set('sleep')
            return
        if s.startswith('run'):
            if d < 3:
                self.x, self.y = tx, ty; self.rest, self.extra = 0.0, None; self.set('idle')
            else:
                k = min(1, self.speed * dt / d)
                self.x += dx * k; self.y += dy * k
                if abs(dx) > 2: self.heading = 1 if dx > 0 else -1
                w = 'runF' if abs(dy) > abs(dx) * 1.4 else ('runR' if dx > 0 else 'runL')
                if w != s and self.t > .15: self.state = w
            return
        # standing still
        if d > 14 * self.sc:
            self.set('runF' if abs(dy) > abs(dx) * 1.4 else ('runR' if dx > 0 else 'runL')); return
        if want == 'sleep': self.set('yawn'); return
        if want: self.set(want); return
        # free: play
        self.rest += dt
        if self.app.music: self.set('dance'); return
        if s in WORK: self.set('idle'); s = 'idle'
        if self.app.mode == 'perch' and self.rest > self.wander_at:
            self.wander = random.uniform(-90, 90) * self.sc; self.wander_at = self.rest + random.uniform(7, 16)
            return
        if s == 'idle' and self.extra is None and self.rest > 3.5:
            self.extra = random.choice(('dance', 'cat', 'idle')); self.set(self.extra)
        elif s in ('cat', 'dance') and self.t > (4.8 if s == 'dance' else 2.5):
            self.set('idle')
        elif s == 'idle' and self.agent is None and self.rest > 25 + random.random() * 5:
            self.set('yawn')

    # -- drawing ----------------------------------------------------------------------------------------
    def place(self):
        self.win.move(int(self.x - self.W / 2), int(self.y - self.foot))

    def frame(self):
        st = self.info()
        f = int(self.t * st['fps'])
        f = f % st['n'] if st['loop'] else min(f, st['n'] - 1)
        return st['n'] - 1 - f if self.rev else f

    def tick_draw(self):
        self.place()
        if self.label and getattr(self, 'calling', None) is not None and self.calling != (self.agent.state == 'ask'): self.shape_input()
        key = (self.state, self.frame(), round(self.duck, 2), self.agent.state if self.agent else None, round(self.shrink, 2))
        if key != self.shown:
            self.shown = key; self.win.queue_draw()

    def draw(self, w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE); cr.set_source_rgba(0, 0, 0, 0); cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        c, f = self.m['cell'], self.frame()
        floor = self.foot
        cr.save()
        if self.shrink < 1:                                                 # being vacuumed into the tray
            cr.translate(self.W / 2, floor - self.cpx * .35); cr.rotate(self.spin); cr.scale(self.shrink, self.shrink)
            cr.translate(-self.W / 2, -(floor - self.cpx * .35))
        cr.rectangle(0, 0, self.W, floor + 2 * self.sc); cr.clip()         # ducking: sink below the edge
        cr.translate((self.W - self.cpx) / 2, self.duck * self.cpx * .72)
        cr.scale(self.sc, self.sc)
        cr.set_source_surface(Strips.get(self.who, self.state), -f * c, 0)
        cr.get_source().set_filter(cairo.FILTER_GOOD)
        cr.rectangle(0, 0, c, c); cr.fill()
        cr.restore()
        if self.label and self.shrink > .98 and self.state not in ('leap', 'fall'): self.draw_label(cr, floor)
        return True

    def draw_label(self, cr, floor):
        a, P = self.agent, self.plate()
        cr.select_font_face('Sans', cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD); cr.set_font_size(P['fs'])
        x0, y0, pw, ph = P['x'], P['y'], P['w'], P['h']
        tone = {'ask': (.82, .9, 1), 'done': (.86, .96, .82), 'asleep': (.9, .88, .86)}.get(a.state if a else '', (1, .98, .95))
        r = ph / 2
        cr.new_path(); cr.arc(x0 + r, y0 + r, r, math.pi / 2, 3 * math.pi / 2); cr.arc(x0 + pw - r, y0 + r, r, -math.pi / 2, math.pi / 2); cr.close_path()
        cr.set_source_rgba(*tone, .92); cr.fill_preserve()
        cr.set_source_rgba(.29, .17, .11, .8); cr.set_line_width(1.2); cr.stroke()
        cr.set_source_rgba(.29, .17, .11, .55 if (a and a.state == 'asleep') else 1)
        cr.move_to(self.W / 2 - P['tw'] / 2, y0 + ph / 2 + P['th'] / 2 - 1); cr.show_text(P['txt'])

class App:
    def __init__(self, a):
        self.scale, self.quiet = a.scale, a.quiet
        self.mode, self.hidden, self.music, self.music_on = 'perch', False, False, True
        self.pets, self.agents = [], {}               # agents: id -> Chibi
        self.dismissed = {}                           # agent id -> when; back when it asks or finishes a turn after that
        self.unused = list(range(1, 12)); random.shuffle(self.unused)
        self.unknown = set()
        self.pointer = Gdk.Display.get_default().get_default_seat().get_pointer()
        if not Gdk.Screen.get_default().is_composited():
            print('ohaiku: no compositor, so the Haikus will have boxes around them', file=sys.stderr)
        self.tk = 0
        self.show_agents = not a.no_agents
        self.surfaces, self.world_ok = [], True
        self.shake, self.studying, self.peeker = [], None, None
        for i in range(a.n): GLib.timeout_add(int(i * 700) + 1, self.add_pet, 'opus0' if a.opus else None)
        GLib.timeout_add(1000 // HZ, self.tick)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, lambda *_: (self.command(), True)[1])
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda *_: (self.quit(), True)[1])
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, lambda *_: (self.quit(), True)[1])
        threading.Thread(target=self.watch, daemon=True).start()
        threading.Thread(target=self.watch_world, daemon=True).start()
        self.tray()

    # -- background watchers: the agents, and whether music is playing ----------------------------------
    def watch(self):
        import agents
        last_music = 0
        while True:
            try:
                res = agents.scan() if self.show_agents else []
                GLib.idle_add(self.got_agents, res)
            except Exception as e:
                print('ohaiku: scan failed:', e, file=sys.stderr)
            if self.music_on and time.time() - last_music > 2:
                last_music = time.time(); m = self.listen()
                if m != self.music: GLib.idle_add(self.set_music, m)
            time.sleep(1.5)

    def watch_world(self):
        try:
            import world
            W = world.Surfaces()
        except Exception as e:
            print('ohaiku: no recess (python-xlib?):', e, file=sys.stderr); self.world_ok = False; return
        while True:
            if self.mode == 'recess' and not self.hidden:
                try: GLib.idle_add(self.set_surfaces, W.poll())
                except Exception as e: print('ohaiku: world:', e, file=sys.stderr)
                time.sleep(.12)
            else:
                time.sleep(.5)

    def set_surfaces(self, s):
        self.surfaces = s; return False

    def set_music(self, m):
        self.music = m and self.music_on; return False

    def listen(self):
        try:
            p = subprocess.Popen(['parec', '--device=@DEFAULT_MONITOR@', '--format=s16le', '--rate=8000', '--channels=1',
                                  '--latency-msec=50'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            b = p.stdout.read(3200); p.kill(); p.wait()
            v = array.array('h', b[:len(b) // 2 * 2])
            return len(v) > 0 and math.sqrt(sum(x * x for x in v) / len(v)) > 300
        except OSError:
            return False

    def note_unknown(self, tool):
        if not tool or tool in self.unknown: return
        self.unknown.add(tool)
        try:
            os.makedirs(os.path.dirname(UNKNOWN), exist_ok=True)
            seen = set(open(UNKNOWN).read().split()) if os.path.exists(UNKNOWN) else set()
            if tool not in seen: open(UNKNOWN, 'a').write(tool + '\n')
        except OSError: pass

    def got_agents(self, res):
        ids, new = set(), []
        now = time.time()
        for a in res:
            if a.id in self.dismissed:
                if a.state in ('ask', 'done') and now - a.age > self.dismissed[a.id]: del self.dismissed[a.id]
                else: continue
            ids.add(a.id)
            c = self.agents.get(a.id)
            if c is None:
                wa = self.workarea()
                c = Chibi(self, a.look, wa.x + wa.width - 80, self.floor(), agent=a, scale=.62 if a.kind == 'sub' else .82,
                          label=a.name)
                self.agents[a.id] = c; new.append(c)
            else:
                c.agent = a
                if c.label != a.name:                         # renamed (/rename): new plate
                    c.label, c._plate = a.name, None; c.shape_input(); c.shown = None
        for k, c in list(self.agents.items()):
            if k not in ids: c.leave()
        self.layout()
        for c in new: c.x = c.slot; c.place()            # bloom where they'll stand
        return False

    # -- where everyone stands ---------------------------------------------------------------------------
    def workarea(self):
        # the pointer's monitor, minus panels (clamped to the monitor: some window managers report odd work areas)
        x, y = self.pointer.get_position()[1:]
        mon = Gdk.Display.get_default().get_monitor_at_point(x, y)
        g, w = mon.get_geometry(), mon.get_workarea()
        r = Gdk.Rectangle()
        r.x, r.y = max(g.x, w.x), max(g.y, w.y)
        root = Gdk.get_default_root_window()
        r.width = min(g.x + g.width, w.x + w.width, root.get_width()) - r.x
        r.height = min(g.y + g.height, w.y + w.height, root.get_height()) - r.y
        return r if r.width > 200 and r.height > 200 else g

    def floor(self):
        wa = self.workarea(); return wa.y + wa.height - LABEL_H

    def order(self):
        sess = sorted((c for c in self.agents.values() if c.agent.kind == 'session'), key=lambda c: c.agent.born)
        ids = {s.agent.id for s in sess}
        out = []
        for s in sess:
            out.append(s)
            out += sorted((c for c in self.agents.values() if c.agent.kind == 'sub' and c.agent.parent == s.agent.id),
                          key=lambda c: c.agent.born)
        out += [c for c in self.agents.values() if c.agent.kind == 'sub' and c.agent.parent not in ids]
        return out + self.pets

    def layout(self):
        wa = self.workarea(); x = wa.x + wa.width - 60
        for c in self.order():
            w = c.cpx * .7 + 6
            c.slot = x - w / 2; x -= w

    def targets(self, cx, cy):
        if self.mode == 'follow':
            prev = None
            for c in self.order():
                if prev is None: yield c, cx + 26 * c.sc, cy + c.foot * .62
                else: yield c, prev.x - prev.heading * prev.cpx * .5, prev.y
                prev = c
        else:
            fl = self.floor()
            for c in self.order():
                yield c, c.slot + (c.wander if c.work() is None else 0), fl

    def tick(self):
        _, cx, cy = self.pointer.get_position()
        dt = 1 / HZ
        if self.studying is not None: self.study_tick(dt); return True
        self.detect_shake(cx)
        fl = self.floor()
        for c, tx, ty in list(self.targets(cx, cy)):
            if c.arc or c.falling: self.air(c, dt)
            elif self.mode == 'recess' and c.state != 'spawn': self.recess(c, dt, fl)
            else:
                if self.mode == 'perch' and c.y < fl - 6 and c.state != 'spawn':     # up on a window: jump down home
                    self.leap(c, c.slot, fl, None)
                else: c.step(dt, tx, ty)
            near = self.mode != 'follow' and abs(cx - c.x) < c.cpx * .45 + 30 and c.y - c.foot - 30 < cy < c.y + 40
            c.duck += (float(near) - c.duck) * min(1, 8 / HZ)
            if c.duck < .01: c.duck = 0
            c.tick_draw()
        for k, c in list(self.agents.items()):
            if c.gone: c.win.destroy(); del self.agents[k]
        for c in [p for p in self.pets if p.gone]: c.win.destroy(); self.pets.remove(c)
        self.tk += 1
        if os.environ.get('OHAIKU_DEBUG') and self.tk % HZ == 0:
            wa = self.workarea()
            print('wa', wa.x, wa.y, wa.width, wa.height, 'mode', self.mode, [(c.label, c.state, int(c.x), int(c.y), int(c.slot)) for c in self.order()], flush=True)
        if self.tk % (HZ * 2) == 0 and not self.hidden:
            for c in self.everyone():
                gw = c.win.get_window()
                if gw: gw.raise_()
        return True

    def everyone(self): return list(self.agents.values()) + self.pets

    # -- recess: the windows are the playground ------------------------------------------------------------
    def surface(self, sid):
        return next((s for s in self.surfaces if s.id == sid), None)

    def leap(self, c, x1, y1, sid):
        d = math.hypot(x1 - c.x, y1 - c.y)
        c.arc = dict(x0=c.x, y0=c.y, x1=x1, y1=y1, sid=sid, t=0.0, T=.45 + d / 1400, h=60 + .25 * d)
        c.goal = None; c.set('leap')

    def land(self, c, sid, y):
        c.arc, c.falling, c.vy = None, False, 0.0
        c.on, c.y = sid, y
        s = self.surface(sid) if sid else None
        c.off = c.x - s.x0 if s else 0.0
        c.rest, c.extra = 0.0, None; c.set('idle')

    def air(self, c, dt):
        fl = self.floor()
        if c.arc:
            A = c.arc; A['t'] += dt; k = min(1, A['t'] / A['T'])
            c.x = A['x0'] + (A['x1'] - A['x0']) * k
            c.y = A['y0'] + (A['y1'] - A['y0']) * k - A['h'] * 4 * k * (1 - k)
            if A['x1'] != A['x0']: c.heading = 1 if A['x1'] > A['x0'] else -1
            c.t += dt
            if k >= 1:
                s = self.surface(A['sid']) if A['sid'] else None
                if A['sid'] and (s is None or not s.stands(c.x)): c.arc = None; c.falling = True; c.set('fall')
                else: self.land(c, A['sid'], s.y if s else fl)
            return
        c.vy += 2600 * dt; ny = c.y + c.vy * dt; c.t += dt
        for s in (self.surfaces if self.mode == 'recess' else []):
            if s.stands(c.x) and c.y <= s.y <= ny: self.land(c, s.id, s.y); return
        if ny >= fl: self.land(c, None, fl); return
        c.y = ny

    def recess(self, c, dt, fl):
        wa = self.workarea()
        s = self.surface(c.on) if c.on else None
        if c.on and (s is None or not s.stands(c.x)):                   # its window moved away, closed, or got covered
            c.on = None; c.falling, c.vy = True, -250.0; c.set('fall'); return
        if s: c.x, c.y = s.x0 + c.off, s.y                              # ride along when the window moves
        else: c.y = fl
        now = time.time()
        free = c.work() is None
        if c.next_hop is None: c.next_hop = now + random.uniform(.3, 3)
        if now > c.next_hop and c.state not in ('sleep', 'yawn', 'wake', 'alert') and (free or not c.settled):
            c.settled = True
            c.next_hop = now + (random.uniform(5, 14) if free else 1e12)
            spots = [x for x in self.surfaces if x.y > wa.y + c.cpx * .9]
            if spots and random.random() < .8:
                t = random.choice(spots); a, b = random.choice(t.segs); x = random.uniform(a + 30, b - 30); y, sid = t.y, t.id
            else:
                x, y, sid = random.uniform(wa.x + 60, wa.x + wa.width - 60), fl, None
            if sid == c.on and abs(x - c.x) < 500: c.goal = x
            else: self.leap(c, x, y, sid); return
        tx = c.goal if c.goal is not None else c.x
        c.step(dt, tx, c.y)
        if c.goal is not None and abs(c.x - c.goal) < 3: c.goal = None
        if s: c.off = c.x - s.x0

    # -- "Nothing! Studying!": shake the mouse and they're all vacuumed into the tray --------------------------
    def detect_shake(self, cx):
        now = time.time()
        self.shake.append((now, cx)); self.shake = [p for p in self.shake if now - p[0] < .7]
        flips, last = 0, 0
        for (t0, x0), (t1, x1) in zip(self.shake, self.shake[1:]):
            dx = x1 - x0
            if abs(dx) < 14: continue
            sg = 1 if dx > 0 else -1
            if last and sg != last: flips += 1
            last = sg
        if flips >= 5 and not self.hidden and self.everyone(): self.study()

    def tray_point(self):
        try:
            ok, scr, area, orient = self.icon.get_geometry()
            if ok and area.width > 1 and (area.x > 0 or area.y > 0): return area.x + area.width / 2, area.y + area.height / 2
        except Exception: pass
        wa = self.workarea(); return wa.x + wa.width - 30, wa.y + wa.height + 10

    def study(self):
        if self.studying is not None: return
        self.studying = 0.0; self.shake = []
        self.vac_to = self.tray_point()
        for c in self.everyone():
            c.arc, c.falling, c.goal = None, False, None
            c.vac_from = (c.x, c.y); c.vac_delay = random.uniform(0, .12)
        if not self.quiet:
            try: subprocess.Popen(['paplay', os.path.join(HERE, 'studying.wav')], stderr=subprocess.DEVNULL)
            except OSError: pass

    def study_tick(self, dt):
        t0 = self.studying; t = self.studying = t0 + dt
        tx, ty = self.vac_to
        if t0 < .5:
            for c in self.everyone():
                k = min(1, max(0, (t - c.vac_delay) / .36)); kk = k * k
                c.x = c.vac_from[0] + (tx - c.vac_from[0]) * kk
                c.y = c.vac_from[1] + (ty + c.foot * .3 - c.vac_from[1]) * kk
                c.shrink = max(.04, 1 - kk); c.spin = kk * 7 * (1 if c.heading > 0 else -1)
                c.set('fall'); c.t += dt; c.tick_draw()
            if t >= .5:                                   # slam: all gone
                for c in self.pets: c.win.destroy()
                self.pets = []
                fl = self.floor()
                for c in self.agents.values():
                    c.win.hide(); c.shrink, c.spin = 1.0, 0.0
                    c.x, c.y, c.on, c.next_hop, c.settled = c.slot, fl, None, None, False; c.set('idle')
                self.hidden, self.mode = True, 'perch'; self.sync_menu()
        elif t >= 3.0 and self.peeker is None:            # ...one peeks back out, and dings
            wa = self.workarea()
            self.peeker = Chibi(self, 'haiku00', max(wa.x + 60, min(tx - 50, wa.x + wa.width - 60)), self.floor())
            self.peeker.duck = 1.0; self.peeker.set('cat'); self.peeker.win.show_all()
            self.dinged = False
        elif self.peeker is not None:
            P = self.peeker; P.t += dt; u = t - 3.0
            P.duck = 1 - .62 * min(1, u / .25) if u < 1.6 else .38 + .62 * min(1, (u - 1.6) / .25)
            if u > .2 and not self.dinged:
                self.dinged = True
                if not self.quiet:
                    try: subprocess.Popen(['paplay', os.path.join(HERE, 'ding.wav')], stderr=subprocess.DEVNULL)
                    except OSError: pass
            P.tick_draw()
            if u > 1.9:
                P.win.destroy(); self.peeker = None; self.studying = None

    def focus(self, c):
        """raise the terminal window this session runs in (Claude Code titles it after the session); else Claude Desktop"""
        a = c.agent
        if a is None: return
        if a.kind == 'sub':
            parent = self.agents.get(a.parent)
            if parent: a = parent.agent
        names = set(a.names or [a.name])
        try:
            wins = subprocess.run(['wmctrl', '-l'], capture_output=True, text=True, timeout=2).stdout.splitlines()
        except (OSError, subprocess.SubprocessError):
            wins = []
        for ln in wins:
            parts = ln.split(None, 3)
            if len(parts) < 4: continue
            title = parts[3]
            if title[:1] and not title[0].isalnum(): title = title[1:].strip()      # Claude Code's ✳ / spinner
            if title in names:
                subprocess.Popen(['wmctrl', '-i', '-a', parts[0]]); return
        # not in a terminal here: the Desktop app's "Sessions Waiting for You" (opens it if it's closed)
        url = 'claude://code/needs-input?source=desktop_action' if a.state in ('ask', 'done', 'free') else 'claude://code/continue?session=last&source=desktop_action'
        try: subprocess.Popen(['xdg-open', url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError: pass

    def agent_menu(self, c):
        m = Gtk.Menu()
        def item(label, fn):
            it = Gtk.MenuItem(label=label); it.connect('activate', lambda *_: fn()); m.append(it)
        if c.agent:
            item('Go to %s' % (c.agent.name if c.agent.kind == 'session' else 'its session'), lambda: self.focus(c))
            item('Send away until needed', lambda: self.dismiss(c))
            m.append(Gtk.SeparatorMenuItem())
        item('Perch (out of the way)', lambda: self.set_mode('perch'))
        item('Follow (chase the pointer)', lambda: self.set_mode('follow'))
        item('Recess (play on the windows)', lambda: self.set_mode('recess'))
        item('Nothing! Studying!', self.study)
        item('Load Up Haiku', self.add_pet)
        m.append(Gtk.SeparatorMenuItem())
        item('Haikus, Go Home', self.quit)
        m.show_all(); self._last_menu = m
        return m

    def dismiss(self, c):
        if c.agent:
            self.dismissed[c.agent.id] = time.time()
            for s in self.agents.values():             # its subagents go with it
                if s.agent.parent == c.agent.id: self.dismissed[s.agent.id] = time.time(); s.leave()
        c.leave()

    # -- loading up, modes, commands -----------------------------------------------------------------------
    def add_pet(self, who=None):
        if who is None:
            if not any(p.who == 'haiku00' for p in self.pets): who = 'haiku00'
            else:
                if not self.unused: self.unused = list(range(1, 12)); random.shuffle(self.unused)
                who = 'haiku%02d' % self.unused.pop()
        _, cx, cy = self.pointer.get_position()
        wa = self.workarea()
        a = random.uniform(0, 2 * math.pi); r = random.uniform(160, 300) * self.scale
        x = min(max(cx + r * math.cos(a), wa.x + 100), wa.x + wa.width - 100)
        y = min(max(cy + r * math.sin(a) + 120, wa.y + 200), wa.y + wa.height - LABEL_H)
        self.pets.append(Chibi(self, who, x, y))
        self.layout()
        if not self.quiet:
            try: subprocess.Popen(['paplay', os.path.join(HERE, 'ding.wav')], stderr=subprocess.DEVNULL)
            except OSError: pass
        return False

    def set_mode(self, m):
        if m == 'toggle': m = 'show' if self.hidden else 'hide'
        if m == 'hide':
            self.hidden = True
            for c in self.everyone(): c.win.hide()
        elif m == 'show':
            self.hidden = False
            for c in self.everyone(): c.win.show_all()
        else:
            if m == 'play': m = 'follow'
            if m == 'recess' and not self.world_ok: m = 'perch'
            for c in self.everyone(): c.next_hop, c.settled, c.goal = None, False, None
            if self.mode == 'recess' and m != 'recess': self.surfaces = []
            self.mode = m
            if self.hidden: self.set_mode('show')
        self.sync_menu()

    def command(self):
        try:
            cmds = open(CMDF).read().split(); os.unlink(CMDF)
        except OSError:
            cmds = ['pet']
        for c in cmds:
            if c == 'pet': self.add_pet()
            elif c == 'opus': self.add_pet('opus%d' % random.randrange(8))
            elif c in ('play', 'follow', 'recess', 'perch', 'hide', 'show', 'toggle'): self.set_mode(c)
            elif c == 'studying': self.study()

    # -- the tray icon, after Plus! Dancer's -------------------------------------------------------------
    def tray(self):
        self.menu_lock, self.radios = False, {}
        try:
            self.icon = Gtk.StatusIcon.new_from_file(os.path.join(HERE, 'sprites', 'icon.png'))
        except Exception:
            self.icon = None; return
        self.icon.set_tooltip_text('ohaiku')
        m = self.menu = Gtk.Menu()

        def item(label, fn):
            it = Gtk.MenuItem(label=label); it.connect('activate', lambda *_: fn()); m.append(it)
        item('Load Up Haiku', self.add_pet)
        item('Load Up Opus', lambda: self.add_pet('opus%d' % random.randrange(8)))
        m.append(Gtk.SeparatorMenuItem())
        grp = None
        for key, label in (('perch', 'Perch (out of the way)'), ('follow', 'Follow (chase the pointer)'),
                           ('recess', 'Recess (play on the windows)'), ('hide', 'Hide')):
            r = Gtk.RadioMenuItem.new_with_label_from_widget(grp, label); grp = grp or r
            r.connect('toggled', lambda w, k=key: (not self.menu_lock and w.get_active()) and self.set_mode(k))
            m.append(r); self.radios[key] = r
        item('Nothing! Studying!  (or shake the mouse)', self.study)
        m.append(Gtk.SeparatorMenuItem())
        ck = Gtk.CheckMenuItem(label='Dance Only When Music Plays'); ck.set_active(True)
        ck.connect('toggled', lambda w: (setattr(self, 'music_on', w.get_active()), setattr(self, 'music', False)))
        m.append(ck)
        ag = Gtk.CheckMenuItem(label='Show Agents'); ag.set_active(self.show_agents)
        ag.connect('toggled', lambda w: setattr(self, 'show_agents', w.get_active())); m.append(ag)
        m.append(Gtk.SeparatorMenuItem())
        item('Haikus, Go Home', self.quit)
        m.show_all()
        self.icon.connect('popup-menu', lambda i, b, t: m.popup(None, None, Gtk.StatusIcon.position_menu, i, b, t))
        self.icon.connect('activate', lambda *_: self.set_mode('show') if self.hidden else self.set_mode('recess' if self.mode == 'perch' else 'perch'))
        self.icon.connect('button-press-event', lambda i, ev: ev.button == 2 and (self.set_mode('toggle') or True))
        self.sync_menu()

    def sync_menu(self):
        if not self.radios: return
        self.menu_lock = True
        self.radios['hide' if self.hidden else self.mode].set_active(True)
        self.menu_lock = False

    def quit(self):
        try: os.unlink(PIDF)
        except OSError: pass
        Gtk.main_quit()


def main():
    p = argparse.ArgumentParser(description='Haiku 5.5 on your desktop.')
    p.add_argument('-n', type=int, default=None, help='how many to load up')
    p.add_argument('--opus', action='store_true', help='a chibi Opus instead')
    p.add_argument('--agents', action='store_true', help='start with just the agents')
    p.add_argument('--no-agents', action='store_true', help='just pets, no agents')
    for m in ('play', 'follow', 'recess', 'perch', 'hide', 'show', 'toggle', 'studying'): p.add_argument('--' + m, action='store_true')
    p.add_argument('--quiet', action='store_true', help='no ding')
    p.add_argument('--scale', type=float, default=1.0)
    p.add_argument('--quit', action='store_true', help='send them home')
    p.add_argument('--restart', action='store_true', help='send them home and start again (agents only)')
    p.add_argument('--fg', action='store_true', help=argparse.SUPPRESS)
    a = p.parse_args()
    modes = [m for m in ('play', 'follow', 'recess', 'perch', 'hide', 'show', 'toggle', 'studying') if getattr(a, m)]
    pid = running_pid()
    if a.quit or a.restart:
        if pid:
            os.kill(pid, signal.SIGTERM)
            for _ in range(50):
                if running_pid() is None: break
                time.sleep(.1)
        if a.quit: return
        pid, a.agents = None, True
    if pid:                                       # already running: tell it
        cmds = modes[:]
        if not modes or a.n or a.opus: cmds += ['opus' if a.opus else 'pet'] * (a.n or 1)
        for c in cmds:
            open(CMDF, 'w').write(c); os.kill(pid, signal.SIGUSR1)
            time.sleep(.7 if c in ('pet', 'opus') else .15)
        return
    a.n = a.n if a.n is not None else (0 if a.agents else 1)
    if not a.fg:
        if os.fork(): return                      # detach, like oneko &
        os.setsid()
    open(PIDF, 'w').write('%d\n' % os.getpid())
    global Gtk, Gdk, GLib, cairo                  # GTK only after the fork
    import gi
    gi.require_version('Gtk', '3.0'); gi.require_version('Gdk', '3.0')
    from gi.repository import Gtk, Gdk, GLib
    import cairo
    sys.path.insert(0, HERE)
    app = App(a)
    for m in modes: app.study() if m == 'studying' else app.set_mode(m)
    Gtk.main()


if __name__ == '__main__':
    main()
