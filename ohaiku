    pid = running_pid()
    if a.status:
        if not pid: print('ohaiku is not running'); return
        try: os.unlink(_RUN + '.status')
        except OSError: pass
        open(CMDF, 'w').write('status'); os.kill(pid, signal.SIGUSR1)
        for _ in range(30):
            time.sleep(.1)
            if os.path.exists(_RUN + '.status'): print(open(_RUN + '.status').read(), end=''); return
        print('ohaiku (pid %d) did not answer' % pid); return
    if a.quit or a.restart:
        if pid:
            os.kill(pid, signal.SIGTERM)
            for _ in range(50):
                if running_pid() is None: break
                time.sleep(.1)
        if a.quit: return
        pid, a.agents = None, True
    if pid:                                       # already running: tell it
        cmds = modes[:] + (['surprise:' + a.surprise] if a.surprise else [])
