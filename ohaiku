        cr.select_font_face('Sans', cairo.FONT_SLANT_ITALIC, cairo.FONT_WEIGHT_BOLD); cr.set_font_size(19)
        self.tw = text_w(cr, self.name)
        self.px = int(self.cell * self.sc)
        self.W, self.H = int(max(self.px * .8, self.tw + 12)), int(self.px * .92 + 30)
        wa = app.workarea()
        self.ox, self.oy, self.Lx, self.Ly = wa.x, wa.y, wa.width - self.W, wa.height - self.H
        v = random.uniform(120, 150) * app.scale
        self.vx, self.vy = v * random.choice((-1, 1)), v * random.uniform(.75, .95) * random.choice((-1, 1))
        self.T = random.uniform(26, 40)                    # when it reaches the corner
        self.ux = random.choice((0, 1)) * self.Lx - self.vx * self.T      # unfolded start: fold the line and you have the bounces
        self.uy = random.choice((0, 1)) * self.Ly - self.vy * self.T
        self.walls = 0
        w = self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
        w.set_app_paintable(True)
        vis = w.get_screen().get_rgba_visual()
        if vis: w.set_visual(vis)
        w.resize(self.W, self.H)
        w.connect('draw', self.draw)
        w.connect('realize', lambda *_: w.input_shape_combine_region(cairo.Region()))
        self.place()
        if not app.hidden and not app.locked: w.show_all()
        c.win.hide()

    @staticmethod
    def fold(u, L):
        m = u % (2 * L); return m if m <= L else 2 * L - m

    def where(self, t):
        ux, uy = self.ux + self.vx * t, self.uy + self.vy * t
        return self.fold(ux, self.Lx), self.fold(uy, self.Ly), math.floor(ux / self.Lx) + math.floor(uy / self.Ly)

    def place(self):
        x, y, self.walls = self.where(min(self.t, self.T))     # a new colour at every wall
        self.win.move(int(self.ox + x), int(self.oy + y))

    def tick(self, dt):
        self.t += dt; c = self.c
        if c.gone or c.work() is not None or self.app.hidden or self.app.locked:      # it's wanted: back to work
            self.hit, self.alpha = self.hit or -1.0, 0
        if self.hit is None and self.t >= self.T:
            self.hit = self.t; self.app.corner(self)
        if self.hit is not None:
            if self.t - self.hit > 2.2: self.alpha -= dt * 1.6
            if self.alpha <= 0:
                self.win.destroy()
                if not c.gone and not self.app.hidden and not self.app.locked: c.win.show_all()
                return False
        self.place(); self.win.queue_draw()
        return True

    def draw(self, w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE); cr.set_source_rgba(0, 0, 0, 0); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER)
        r, g, b = self.COLOURS[self.walls % len(self.COLOURS)]
        if self.hit is not None and self.hit > 0 and self.t - self.hit < 1.4 and int((self.t - self.hit) * 6) % 2 == 0: r, g, b = 1, 1, 1
        cr.push_group()
        cr.save(); cr.translate((self.W - self.px) / 2, -self.px * .06); cr.scale(self.sc, self.sc)
        cr.set_source_surface(self.img, -(int(self.t * 12) % 36) * self.cell, 0); cr.get_source().set_filter(cairo.FILTER_GOOD)
        cr.rectangle(0, 0, self.cell, self.cell); cr.fill(); cr.restore()
        cr.set_operator(cairo.OPERATOR_ATOP); cr.set_source_rgba(r, g, b, .62); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER)
        cr.set_source_rgb(r, g, b)
        cr.select_font_face('Sans', cairo.FONT_SLANT_ITALIC, cairo.FONT_WEIGHT_BOLD); cr.set_font_size(19)
        cr.move_to((self.W - self.tw) / 2, self.px * .86 + 12); show_text(cr, self.name)
        cr.save(); cr.translate(self.W / 2, self.px * .86 + 22); cr.scale(min(self.W * .42, self.tw * .5 + 6), 4.5)
        cr.arc(0, 0, 1, 0, 2 * math.pi); cr.restore(); cr.fill()                       # the disc
        cr.pop_group_to_source(); cr.paint_with_alpha(max(0, self.alpha))
        return True


