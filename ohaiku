#!/usr/bin/env python3
"""ohaiku — Haiku 5.5 on your desktop. After oneko (Masayuki Koba, 1989), xneko, and Plus! Dancer (2003).

  ohaiku              start, and load up a Haiku (if already running: load up another, with a ding)
  ohaiku --agents     start with just the agents (for autostart)
  ohaiku -n 5         load up five
  ohaiku --opus       load up a chibi Opus
  ohaiku --perch      everyone on the bottom edge, out of the way (the default)
  ohaiku --follow     everyone chases the pointer in a line (oneko); --play does the same
  ohaiku --recess     they play on your windows: climb onto title bars, hop between them, ride along, fall off
  ohaiku --tag        one Haiku surfs your pointer; the rest run from it; touch one and it's It
  ohaiku --bloomcore  the bc1 eruption: ten more Haikus burst out of the tray, everyone dances on the windows,
                      and a flower opens wherever one lands
  ohaiku --movie      movie night: they open a window, put on a film (muted), and watch it from a row of cinema
                      seats, headphones on. The programme is ~/.config/ohaiku/programme.txt (files, folders, URLs);
                      drag a video onto the theater to put it on next. In Recess and Bloomcore they sometimes do this
                      by themselves
  ohaiku --lemmings   "Let's go!": ten Haikus drop from a trapdoor over your windows and march for the flower door.
                      Click one to build (Q.E.D. bricks), middle-click to float (dandelion), right-click to block.
                      If you don't play, a director does.  --ohno nukes them ("Oh no!")
  ohaiku --fly        Flying Haikus (After Dark's Flying Toasters); also the screensaver after --saver minutes idle
                      (default 5, 0 = never); move the mouse and they scatter
  ohaiku --kaiju      chibi Opus, five times the size, stomps along the bottom; everyone hides (rarely by itself, too)
  ohaiku --clippy     "It looks like you're...": a balloon about your active window (now and then by itself in play)
  ohaiku --snow       petal snow (xsnow, bloomcore edition): petals pile up on your title bars; on during Bloomcore
  ohaiku --leaves     autumn: maple, ginkgo and aspen leaves flutter down in a gusty wind that blows the drifts back off
  ohaiku --gallery    the Peanut Gallery (off unless you ask): the free ones sit in a row along the bottom with their
                      backs to you and watch your screen. Soon after it changes (every ~6 s at most), a screenshot (terminals
                      and the Claude app blacked out) goes to Haiku, which voices their quips and keeps notes of anything worth
                      keeping in ~/.local/share/ohaiku/gallery/. Click the placard to stop; again to toggle
  ohaiku --studying   "Nothing! Studying!": everyone vacuumed into the tray, silently (also: shake the mouse)
  ohaiku --hide       vanish (they keep watching); --show to come back; --toggle for a hotkey
  ohaiku --quiet      no ding;  --scale 1.3  bigger (when starting)
  ohaiku --quit       Haikus, go home;  --restart  go home and come back (agents only);  --status  what they're up to

Every Claude Code session on this machine that was active in the last two hours gets a chibi of its own model, with
its name on a little plate, standing on the bottom edge of the screen and acting out what it's doing: reading, searching
(magnifying glass), editing (the Q.E.D. stamp), running commands (the drum), thinking (a thought cloud), sending out
subagents (seed packets; the subagents appear beside it), asking you something or waiting at a permission prompt
(waving a "?", and saying so), done (a happy bounce), out of usage (a tea break until the limit resets), an API error
(dizzy), and asleep after twenty quiet minutes. The little flower on each plate opens over the day's work. Free ones wander and play, and dance when music is playing. Bring the pointer
near and they duck below the edge so only their hoods peek out. Click a name plate (or a chibi waving "?") to go to
that session's terminal window; middle-click a plate to send that one away until its session wants you again; right-click
for the menu. Middle-click the tray icon to hide or show everyone.

X11 with a compositor. Every window is click-through.
"""
import argparse, array, collections, json, math, os, random, signal, subprocess, sys, threading, time

HERE = os.path.dirname(os.path.realpath(__file__))
SHARE = os.path.join(HERE, 'share')
_RUN = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'), 'ohaiku%s' % os.environ.get('DISPLAY', '').replace(':', '-'))
PIDF, CMDF = _RUN + '.pid', _RUN + '.cmd'
UNKNOWN = os.path.expanduser('~/.cache/ohaiku/unknown-tools.txt')
HZ = 30
CASCADE_MIN = float(os.environ.get('OHAIKU_CASCADE_MIN', 8 * 60))   # seconds of work that earn a Solitaire cascade
LABEL_H = 17

# what each tool looks like; anything not here gets 'busy' and is noted in UNKNOWN, so a new drawing can be made for it
TOOL_POSE = {
    'Bash': 'bash', 'BashOutput': 'bash', 'KillShell': 'bash', 'Monitor': 'bash', 'TaskStop': 'bash',
    'Read': 'read', 'NotebookRead': 'read', 'WebFetch': 'read', 'Skill': 'read', 'ReadNotifications': 'read',
    'Grep': 'search', 'Glob': 'search', 'WebSearch': 'search', 'ToolSearch': 'search', 'ListAgents': 'search',
    'Edit': 'edit', 'Write': 'edit', 'MultiEdit': 'edit', 'NotebookEdit': 'edit', 'Artifact': 'edit',
    'Agent': 'agents', 'Task': 'agents', 'Workflow': 'agents', 'SendMessage': 'agents', 'SendUserFile': 'agents',
    'SubagentHandback': 'done',
    'TodoWrite': 'think', 'EnterPlanMode': 'think',
    'AskUserQuestion': 'ask', 'ExitPlanMode': 'ask', 'PushNotification': 'ask',
}
TOOL_PREFIX = {'mcp__': 'search'}
WORK = {'think', 'ask', 'done', 'bash', 'read', 'search', 'edit', 'agents', 'busy', 'tea', 'dizzy'}
GAL_GAP, GAL_IDLE = 6, 300                           # the Peanut Gallery looks soon after the screen changes, but at most
                                                      # once every GAL_GAP s; and once in GAL_IDLE s even if nothing has
GAL_SPACE = 2.8                                       # seconds between two of its lines
KINDS = ['Sunflower', 'Daisy', 'Tulip', 'Rose', 'Poppy', 'Cherry', 'Cornflower', 'Marigold', 'Lotus', 'Dandelion', 'Cosmos', 'Pansy']
SAYS = {'permission prompt': 'may I? (permission)', 'input needed': 'a question for you', 'dialog open': 'a dialog for you',
        'sandbox request': 'may I use the network?', 'worker request': 'a helper needs you', 'goal proposal': 'a goal for us?',
        'AskUserQuestion': 'a question for you', 'ExitPlanMode': 'plan ready!', 'PushNotification': 'psst'}


def running_pid():
    try:
        pid = int(open(PIDF).read())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def clip(s, n):
    """s, cut at a word to at most n characters"""
    s = ' '.join(str(s).split())
    return s if len(s) <= n else s[:n - 1].rsplit(' ', 1)[0].rstrip(',;:.') + '\u2026'


def _layout(cr, s):
    """s in cr's current (toy) font, as a Pango layout: Pango falls back to other fonts for what that one lacks (emoji
    in a session's name, symbols, CJK), where cairo's toy show_text draws an empty box"""
    f, d = cr.get_font_face(), Pango.FontDescription()
    d.set_family(f.get_family() if isinstance(f, cairo.ToyFontFace) else 'Sans')
    if isinstance(f, cairo.ToyFontFace) and f.get_weight() == cairo.FONT_WEIGHT_BOLD: d.set_weight(Pango.Weight.BOLD)
    if isinstance(f, cairo.ToyFontFace) and f.get_slant() == cairo.FONT_SLANT_ITALIC: d.set_style(Pango.Style.ITALIC)
    d.set_absolute_size(cr.get_font_matrix().xx * Pango.SCALE)
    L = PangoCairo.create_layout(cr); L.set_font_description(d); L.set_text(s, -1)
    return L


def text_w(cr, s):
    """how wide s is in cr's current font (text_w(cr, s), with font fallback)"""
    return _layout(cr, s).get_extents()[1].width / Pango.SCALE


def show_text(cr, s):
    """show_text(cr, s), with font fallback: s sits on the baseline at the current point"""
    L = _layout(cr, s); x, y = cr.get_current_point()
    cr.move_to(x, y - L.get_baseline() / Pango.SCALE); PangoCairo.show_layout(cr, L)


class Strips:
    meta, surf = None, {}

    @classmethod
    def info(cls, who):
        if cls.meta is None: cls.meta = json.load(open(os.path.join(SHARE, 'sheets.json')))
        return cls.meta[who]

    @classmethod
    def get(cls, who, state):
        k = (who, state)
        if k not in cls.surf: cls.surf[k] = cairo.ImageSurface.create_from_png(os.path.join(SHARE, who, state + '.png'))
        return cls.surf[k]


class Chibi:
    """one character: a pet (loaded up by hand) or an agent (a Claude Code session or subagent)"""

    def __init__(self, app, who, x, y, agent=None, scale=1.0, label=None):
        self.app, self.who, self.agent, self.label = app, who, agent, label
        self.m = Strips.info(who)
        self.sc = scale * app.scale
        self.cpx = int(self.m['cell'] * self.sc)
        self.x, self.y = x, y
        self.heading = random.choice((-1, 1))
        self.state, self.t, self.rest, self.extra, self.rev = 'spawn', 0.0, 0.0, None, False
        self.speed = 400 * self.sc
        self.slot = x
        self.wander = 0.0; self.wander_at = random.uniform(6, 14)
        self.duck, self.hop, self.cheer = 0.0, 0.0, 0.0     # hop: up off the floor (the wave); cheer: arms up until then
        self.shown, self.gone = None, False
        self.shrink, self.spin = 1.0, 0.0                 # the vacuum ("Nothing! Studying!")
        self.on, self.off, self.arc, self.vy, self.falling = None, 0.0, None, 0.0, False   # recess: which window top
        self.next_hop, self.goal, self.settled = None, None, False
        self.W = self.cpx + 40 if label else self.cpx
        self.H = self.cpx + (LABEL_H if label else 0)
        w = self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
        w.set_app_paintable(True)
        vis = w.get_screen().get_rgba_visual()
        if vis: w.set_visual(vis)
        w.set_default_size(self.W, self.H); w.resize(self.W, self.H)
        w.set_accept_focus(False)
        w.connect('draw', self.draw)
        w.connect('realize', lambda *_: self.shape_input())
        w.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        w.connect('button-press-event', self.clicked)
        self.place()
        if not app.hidden and not app.locked: w.show_all()

    @property
    def foot(self): return self.m['foot'][1] * self.sc

    # -- the name plate: the only part that takes clicks ------------------------------------------------
    def plate(self):
        if getattr(self, '_plate', None): return self._plate
        cr = cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 4, 4))
        cr.select_font_face('Sans', cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        fs = 10 if (self.agent and self.agent.kind == 'sub') else 11.5
        cr.set_font_size(fs)
        txt = self.label if len(self.label) <= 18 else self.label[:17] + '…'
        pad = 15 if (self.agent and self.agent.kind == 'session') else 0      # room for the day's flower
        tw = text_w(cr, txt)
        while tw + 12 + pad > self.W - 2 and len(txt) > 4:
            txt = txt[:-2] + '…'; tw = text_w(cr, txt)
        pw, ph = tw + 12 + pad, LABEL_H - 3
        th = cr.text_extents(txt).height                    # (as the toy font sees it: plain names sit where they always did)
        self._plate = dict(txt=txt, fs=fs, tw=tw, th=th, x=(self.W - pw) / 2, y=self.foot + 1, w=pw, h=ph, pad=pad)
        return self._plate

    def shape_input(self):
        if getattr(self, 'lem', None) is not None:      # a lemming: the whole body takes clicks (that's the game)
            self.win.input_shape_combine_region(cairo.Region(cairo.RectangleInt(int(self.W / 2 - self.cpx * .3),
                int(self.foot - self.cpx * .78), int(self.cpx * .6), int(self.cpx * .8)))); return
        if not self.label: self.win.input_shape_combine_region(cairo.Region()); return    # pets: click-through
        P = self.plate(); reg = cairo.Region(cairo.RectangleInt(int(P['x']), int(P['y']), int(P['w']) + 1, int(P['h']) + 1))
        self.calling = bool(self.agent and self.agent.state == 'ask')
        if self.calling:          # waving at you: the whole chibi is a button
            reg.union(cairo.RectangleInt(int(self.W / 2 - self.cpx * .3), int(self.foot - self.cpx * .8), int(self.cpx * .6), int(self.cpx * .8)))
        self.win.input_shape_combine_region(reg)

    def clicked(self, w, ev):
        if getattr(self, 'lem', None) is not None: self.app.lem_click(self, ev.button); return True
        if ev.button == 1: self.app.focus(self)
        elif ev.button == 2: self.app.dismiss(self)
        elif ev.button == 3: self.app.agent_menu(self).popup_at_pointer(ev)
        return True

    # -- what it would like to be doing when it isn't running somewhere --------------------------------
    def work(self):
        a = self.agent
        if a is None: return None
        if a.state == 'think': return 'think'
        if a.state == 'ask': return 'ask'
        if a.state == 'done': return 'done'
        if a.state == 'asleep': return 'sleep' if self.app.mode == 'perch' and not self.app.gallery_on else None   # playtime wakes everyone
        if a.state == 'limit': return 'tea'
        if a.state == 'error': return 'dizzy'
        if a.state == 'tool':
            p = TOOL_POSE.get(a.tool)
            if p is None:
                p = next((v for k, v in TOOL_PREFIX.items() if (a.tool or '').startswith(k)), None)
                if p is None: p = 'busy'; self.app.note_unknown(a.tool)
            return p
        return None                                             # free

    def set(self, state, rev=False):
        if state != self.state or rev != self.rev: self.state, self.t, self.rev = state, 0.0, rev

    def info(self, state=None):
        return self.m['states'][state or self.state]

    def done_anim(self):
        st = self.info(); return not st['loop'] and self.t * st['fps'] >= st['n']

    def leave(self):
        if not (self.state == 'spawn' and self.rev): self.set('spawn', rev=True)

    def step(self, dt, tx, ty):
        self.t += dt
        s = self.state
        if s == 'spawn':
            if self.done_anim():
                if self.rev: self.gone = True; return
                self.set('idle')
            return
        dx, dy = tx - self.x, ty - self.y
        d = math.hypot(dx, dy)
        want = self.work()
        if s == 'sleep':
            if want != 'sleep' and (want is not None or d > 40 * self.sc or self.agent is None or self.app.mode != 'perch' or self.app.gallery_on): self.set('wake')
            return
        if s == 'wake':
            if self.done_anim(): self.set('alert')
            return
        if s == 'alert':
            if self.done_anim() and self.t > .45: self.set('idle')
            return
        if s == 'yawn':
            if d > 30 * self.sc or want not in (None, 'sleep'): self.set('alert')
            elif self.done_anim(): self.set('sleep')
            return
        if s.startswith('run'):
            if d < 3:
                self.x, self.y = tx, ty; self.rest, self.extra = 0.0, None; self.set('idle')
            else:
                k = min(1, self.speed * dt / d)
                self.x += dx * k; self.y += dy * k
                if abs(dx) > 2: self.heading = 1 if dx > 0 else -1
                w = 'runF' if abs(dy) > abs(dx) * 1.4 else ('runR' if dx > 0 else 'runL')
                if w != s and self.t > .15: self.state = w
            return
        # standing still
        if d > 14 * self.sc:
            self.set('runF' if abs(dy) > abs(dx) * 1.4 else ('runR' if dx > 0 else 'runL')); return
        if want == 'sleep': self.set('yawn'); return
        if want: self.set(want); return
        # free: play (or, with the Peanut Gallery on, sit in the row and watch the screen)
        if self.app.gallery_seats():
            self.wander, rc = 0.0, getattr(self, 'react', None)
            if rc and time.time() < rc[1]: pose = 'g' + rc[0]
            elif self.state == 'gmunch' and self.t < 6: pose = 'gmunch'
            else: pose = 'gmunch' if random.random() < dt / 45 else 'gwatch'
            if pose != self.state: self.set(pose)
            return
        if time.time() < self.cheer: self.set('done'); return
        self.rest += dt
        if self.app.music or self.app.mode == 'bloomcore':          # the shimmy and the floss, taking turns
            if s not in ('dance', 'floss') or self.t > getattr(self, 'dance_for', 0):
                self.set('dance' if s == 'floss' else 'floss' if s == 'dance' or random.random() < .4 else 'dance')
                self.dance_for = random.uniform(6, 14)
            return
        if s in WORK: self.set('idle'); s = 'idle'
        if self.app.mode == 'perch' and self.rest > self.wander_at:
            self.wander = random.uniform(-90, 90) * self.sc; self.wander_at = self.rest + random.uniform(7, 16)
            return
        if s == 'idle' and self.extra is None and self.rest > 3.5:
            self.extra = random.choice(('dance', 'floss', 'cat', 'idle')); self.set(self.extra)
        elif s in ('cat', 'dance', 'floss') and self.t > (4.8 if s in ('dance', 'floss') else 2.5):
            self.set('idle')
        elif s == 'idle' and self.agent is None and self.rest > 25 + random.random() * 5:
            self.set('yawn')

    # -- drawing ----------------------------------------------------------------------------------------
    def place(self):
        self.win.move(int(self.x - self.W / 2), int(self.y - self.foot - self.hop))

    def frame(self):
        st = self.info()
        f = int(self.t * st['fps'])
        f = f % st['n'] if st['loop'] else min(f, st['n'] - 1)
        return st['n'] - 1 - f if self.rev else f

    def tick_draw(self):
        self.place()
        if self.label and getattr(self, 'calling', None) is not None and self.calling != (self.agent.state == 'ask'): self.shape_input()
        key = (self.state, self.frame(), round(self.duck, 2), self.agent.state if self.agent else None, round(self.shrink, 2), self.bloom())
        if key != self.shown:
            self.shown = key; self.win.queue_draw()

    def draw(self, w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE); cr.set_source_rgba(0, 0, 0, 0); cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        c, f = self.m['cell'], self.frame()
        floor = self.foot
        cr.save()
        if self.shrink < 1:                                                 # being vacuumed into the tray
            cr.translate(self.W / 2, floor - self.cpx * .35); cr.rotate(self.spin); cr.scale(self.shrink, self.shrink)
            cr.translate(-self.W / 2, -(floor - self.cpx * .35))
        cr.rectangle(0, 0, self.W, floor + 2 * self.sc); cr.clip()         # ducking: sink below the edge
        cr.translate((self.W - self.cpx) / 2, self.duck * self.cpx * .72)
        cr.scale(self.sc, self.sc)
        cr.set_source_surface(Strips.get(self.who, self.state), -f * c, 0)
        cr.get_source().set_filter(cairo.FILTER_GOOD)
        cr.rectangle(0, 0, c, c); cr.fill()
        cr.restore()
        if self.label and self.shrink > .98 and self.state not in ('leap', 'fall'): self.draw_label(cr, floor)
        return True

    def bloom(self):
        """which frame of its flower the plate shows: bud at the first minute of work today, full bloom at four hours"""
        a = self.agent
        if not a or a.kind != 'session' or getattr(a, 'today', 0) < 60: return None
        return int(round(11 * min(1, math.sqrt(a.today / (4 * 3600)))))

    def draw_label(self, cr, floor):
        a, P = self.agent, self.plate()
        cr.select_font_face('Sans', cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD); cr.set_font_size(P['fs'])
        x0, y0, pw, ph = P['x'], P['y'], P['w'], P['h']
        tone = {'ask': (.82, .9, 1), 'done': (.86, .96, .82), 'asleep': (.9, .88, .86), 'limit': (.9, .87, 1), 'error': (1, .86, .84)}.get(a.state if a else '', (1, .98, .95))
        r = ph / 2
        cr.new_path(); cr.arc(x0 + r, y0 + r, r, math.pi / 2, 3 * math.pi / 2); cr.arc(x0 + pw - r, y0 + r, r, -math.pi / 2, math.pi / 2); cr.close_path()
        cr.set_source_rgba(*tone, .92); cr.fill_preserve()
        cr.set_source_rgba(.29, .17, .11, .8); cr.set_line_width(1.2); cr.stroke()
        cr.set_source_rgba(.29, .17, .11, .55 if (a and a.state == 'asleep') else 1)
        cr.move_to(self.W / 2 - P['tw'] / 2 + P['pad'] / 2, y0 + ph / 2 + P['th'] / 2 - 1); show_text(cr, P['txt'])
        if not P['pad']: return
        b, cx = self.bloom(), x0 + 10
        if b is None:                                       # no work yet today: a seed
            cr.set_source_rgba(.45, .3, .16, .8); cr.new_path(); cr.save(); cr.translate(cx, y0 + ph / 2); cr.scale(1, .7); cr.arc(0, 0, 2.6, 0, 7); cr.restore(); cr.fill()
            return
        k = 'bloom%02d' % (int(''.join(ch for ch in self.who if ch.isdigit()) or 0) % 12)   # the day's work, opening
        if k not in Flower.surf: Flower.surf[k] = cairo.ImageSurface.create_from_png(os.path.join(SHARE, 'blooms', k + '.png'))
        img = Flower.surf[k]; px = img.get_height(); z = 34 / px
        cr.save(); cr.translate(cx - 17, y0 + ph - 34 * .9); cr.scale(z, z)
        cr.set_source_surface(img, -b * px, 0); cr.rectangle(0, 0, px, px); cr.clip(); cr.paint(); cr.restore()

class Plane:
    """a paper airplane: one session's SendMessage, flying from its chibi to the recipient's (or off the top)"""

    def __init__(self, app, src, dst):
        self.app, self.dst, self.t = app, dst, 0.0
        self.p0 = (src.x + 10, src.y - src.foot * .8)
        self.p2 = (dst.x, dst.y - dst.foot * .8) if dst else (src.x + random.uniform(-300, 300), -60)
        d = math.hypot(self.p2[0] - self.p0[0], self.p2[1] - self.p0[1])
        self.p1 = ((self.p0[0] + self.p2[0]) / 2, min(self.p0[1], self.p2[1]) - 120 - .25 * d)
        self.T = 1.2 + d / 1300
        self.ang = 0.0
        w = self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
        w.set_app_paintable(True)
        vis = w.get_screen().get_rgba_visual()
        if vis: w.set_visual(vis)
        w.resize(64, 64)
        w.connect('draw', self.draw)
        w.connect('realize', lambda *_: w.input_shape_combine_region(cairo.Region()))
        self.place()
        if not app.hidden and not app.locked: w.show_all()

    def pos(self, k):
        (x0, y0), (x1, y1), (x2, y2) = self.p0, self.p1, self.p2
        if self.dst: x2, y2 = self.dst.x, self.dst.y - self.dst.foot * .8          # follow a moving target
        a, b, c = (1 - k) ** 2, 2 * k * (1 - k), k * k
        return a * x0 + b * x1 + c * x2, a * y0 + b * y1 + c * y2

    def place(self):
        k = min(1, self.t / self.T); x, y = self.pos(k); x2, y2 = self.pos(min(1, k + .02))
        self.ang = math.atan2(y2 - y, x2 - x) + .25 * math.sin(self.t * 9)
        self.win.move(int(x - 32), int(y - 32))

    def tick(self, dt):
        self.t += dt; self.place(); self.win.queue_draw()
        if self.t >= self.T:
            if self.dst and not self.dst.gone and self.dst.state in ('idle', 'cat', 'dance', 'floss', 'think'):
                self.dst.set('alert')                                    # "!": got mail
            self.win.destroy(); return False
        return True

    def draw(self, w, cr):
