    def sync_menu(self):
        if not self.radios: return
        self.menu_lock = True
        self.radios['hide' if self.hidden else self.mode].set_active(True)
        self.menu_lock = False

    def quit(self):
        self.gallery_on = False
        if self.theater: self.theater.close()
        try: os.unlink(PIDF)
        except OSError: pass
        Gtk.main_quit()


