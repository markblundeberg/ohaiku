LEAVES = [('maple', [(.78, .16, .12), (.88, .3, .14), (.93, .5, .12), (.7, .2, .16)]),          # (shape, colours)
          ('ginkgo', [(.98, .78, .2), (.95, .84, .32), (.93, .7, .16)]),
