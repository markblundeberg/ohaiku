VIDEO_EXT = ('.mp4', '.webm', '.mkv', '.mov', '.avi', '.m4v', '.gif')


def programme():
    if not os.path.exists(PROGRAMME):
        os.makedirs(os.path.dirname(PROGRAMME), exist_ok=True); open(PROGRAMME, 'w').write(PROGRAMME_DEFAULT)
    out = []
    for ln in open(PROGRAMME):
        ln = ln.strip()
        if not ln or ln.startswith('#'): continue
        if '://' in ln: out.append(ln); continue
        p = os.path.expanduser(ln)
        if os.path.isdir(p):
            for root, _, files in os.walk(p):
                out += [os.path.join(root, f) for f in files if f.lower().endswith(VIDEO_EXT)]
        elif os.path.exists(p): out.append(p)
    return out


class Reel:
    """one film, decoded by ffmpeg into a queue of 12 fps frames (muted); URLs go through yt-dlp first"""
    W, H = 448, 252

    def __init__(self, src):
        import queue
        self.src, self.q, self.done, self.procs = src, queue.Queue(maxsize=36), False, []
        self.name = src if '://' in src else os.path.splitext(os.path.basename(src))[0]
        threading.Thread(target=self.run, daemon=True).start()

    def run(self):
        vf = 'fps=12,scale=%d:%d:force_original_aspect_ratio=decrease,pad=%d:%d:(ow-iw)/2:(oh-ih)/2:color=black' % (self.W, self.H, self.W, self.H)
        ff = ['ffmpeg', '-v', 'error', '-nostdin']
        try:
            if '://' in self.src:
                yt = subprocess.Popen(['yt-dlp', '-q', '-f', 'best[height<=480]/best', '-o', '-', self.src],
                                      stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                self.procs.append(yt); ff += ['-i', '-']; stdin = yt.stdout
            else:
                try:
                    dur = float(subprocess.run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'csv=p=0', self.src],
                                               capture_output=True, text=True, timeout=5).stdout.strip() or 0)
                except (ValueError, subprocess.SubprocessError): dur = 0
                if dur > 360: ff += ['-ss', '%.1f' % random.uniform(0, dur - 300)]      # a long one: drop in somewhere
                ff += ['-i', self.src]; stdin = subprocess.DEVNULL
            pr = subprocess.Popen(ff + ['-an', '-vf', vf, '-f', 'rawvideo', '-pix_fmt', 'bgra', '-'], stdin=stdin,
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            self.procs.append(pr)
            n = self.W * self.H * 4
            while True:
                buf = pr.stdout.read(n)
                if len(buf) < n: break
                self.q.put(buf)
        except OSError:
            pass
        self.done = True

    def stop(self):
        for p in self.procs:
            try: p.kill()
            except OSError: pass
        self.done = True


class Theater:
    """Movie night: the pets' own window, playing films on mute (after MST3K, they sit in a row in front of it)"""

    def __init__(self, app, x, y):
        self.app, self.t, self.reel, self.surf, self.queue_next = app, 0.0, None, None, []
        self.reels = programme(); random.shuffle(self.reels); self.ri = 0
        w = self.win = Gtk.Window(title='Haiku Theater 3000')
        w.set_accept_focus(False); w.set_focus_on_map(False)
        self.area = Gtk.DrawingArea(); self.area.set_size_request(Reel.W, Reel.H); w.add(self.area)
        self.area.connect('draw', self.draw)
        w.connect('delete-event', lambda *_: (app.theater_closed(), False)[1])
        w.drag_dest_set(Gtk.DestDefaults.ALL, [], Gdk.DragAction.COPY); w.drag_dest_add_uri_targets()
        w.connect('drag-data-received', self.dropped)
        w.move(int(x), int(y))
        self.next()
        if not app.hidden and not app.locked: self.show()

    def show(self):
        # (raise_() is ignored for a window that never had focus; a moment of keep-above lifts it without focus)
        self.win.show_all()
        self.win.set_keep_above(True)
        GLib.timeout_add(400, lambda: (self.win.set_keep_above(False), False)[1])

    def dropped(self, w, ctx, x, y, data, info, t):
        from urllib.parse import unquote, urlparse
        for u in data.get_uris():
            p = unquote(urlparse(u).path) if u.startswith('file://') else u
            self.queue_next.append(p)
        self.next()

    def next(self):
        if self.reel: self.reel.stop()
        if self.queue_next: src = self.queue_next.pop(0)
        elif self.reels: src = self.reels[self.ri % len(self.reels)]; self.ri += 1
        else: self.reel = None; self.win.set_title('Haiku Theater 3000 \u2014 (nothing on: add films to %s)' % PROGRAMME); return
        self.reel = Reel(src); self.t = 0.0
        self.win.set_title('Haiku Theater 3000 \u2014 %s (muted)' % self.reel.name)

    def tick(self, dt):
        self.t += dt
        R = self.reel
        if not R: return
        if self.t >= 1 / 12:
            self.t = 0.0
            try:
                buf = R.q.get_nowait()
                self.surf = cairo.ImageSurface.create_for_data(bytearray(buf), cairo.FORMAT_ARGB32, Reel.W, Reel.H, Reel.W * 4)
                self.area.queue_draw()
            except Exception:
                if R.done and R.q.empty(): self.next()

    def close(self):
        if self.reel: self.reel.stop()

    def draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        cr.set_source_rgb(0, 0, 0); cr.paint()
        if self.surf:
            k = min(W / Reel.W, H / Reel.H)
            cr.translate((W - Reel.W * k) / 2, (H - Reel.H * k) / 2); cr.scale(k, k)
            cr.set_source_surface(self.surf, 0, 0); cr.paint()
        return True

    def seats(self, n):
        gw = self.area.get_window()
        if gw is None: return None
        o = gw.get_origin(); ox, oy = (o[1], o[2]) if len(o) == 3 else o
        W, H = self.area.get_allocated_width(), self.area.get_allocated_height()
        return [(ox + W * (i + .5) / n, oy + H + 6) for i in range(n)]


