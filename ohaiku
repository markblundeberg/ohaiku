        w.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        w.connect('button-press-event', lambda *_: (app.gallery(False), True)[1])
        w.set_tooltip_text('The Peanut Gallery is watching your screen (Haiku). Click to stop.')
        if not app.hidden and not app.locked: w.show_all()

    def tick(self, dt, x, y):
        self.blink = max(0.0, self.blink - dt)
        self.win.move(int(x - self.W), int(y - self.H))
        why = self.app.gal_why
        self.paused = not why.startswith(('watching', 'looking', 'settling'))
        if self.app.tk % 15 == 0: self.win.set_tooltip_text('Peanut Gallery: %s. Click to stop.' % why)
        k = (round(self.blink, 1), self.paused)
        if k != self.shown: self.shown = k; self.win.queue_draw()

    def draw(self, w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE); cr.set_source_rgba(0, 0, 0, 0); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER)
        W, H, r = self.W - 2, self.H - 2, 9
        cr.new_path(); cr.arc(1 + r, 1 + r, r, math.pi, 1.5 * math.pi); cr.arc(W - r, 1 + r, r, 1.5 * math.pi, 0)
        cr.arc(W - r, H - r, r, 0, .5 * math.pi); cr.arc(1 + r, H - r, r, .5 * math.pi, math.pi); cr.close_path()
        cr.set_source_rgba(.165, .08, .086, .94); cr.fill_preserve(); cr.set_source_rgba(.85, .47, .34, .9); cr.set_line_width(1.5); cr.stroke()
        a = .35 + .65 * min(1, self.blink / .6)
        if getattr(self, 'paused', False): cr.set_source_rgba(.6, .55, .5, .8)        # paused: a grey dot (hover says why)
        else: cr.set_source_rgba(.92, .2, .2, a)
        cr.arc(14, self.H / 2, 4.5, 0, 7); cr.fill()
        cr.select_font_face('Sans', cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD); cr.set_font_size(10.5)
        cr.set_source_rgb(1, .93, .8); cr.move_to(25, self.H / 2 + 4); show_text(cr, 'PEANUT GALLERY')
        return True


class App:
    def __init__(self, a):
        self.scale, self.quiet = a.scale, a.quiet
        self.mode, self.hidden, self.music, self.music_on = 'perch', False, False, True
        self.locked = False                           # screen locked: everyone hides and holds still
        self.pets, self.agents = [], {}               # agents: id -> Chibi
        self.dismissed = {}                           # agent id -> when; back when it asks or finishes a turn after that
        self.unused = list(range(1, 12)); random.shuffle(self.unused)
        self.unknown = set()
        self.pointer = Gdk.Display.get_default().get_default_seat().get_pointer()
        if not Gdk.Screen.get_default().is_composited():
            print('ohaiku: no compositor, so the Haikus will have boxes around them', file=sys.stderr)
        self.tk = 0
        self.show_agents = not a.no_agents
        self.surfaces, self.world_ok = [], True
        self.shake, self.studying, self.peeker = [], None, None
        self.balloons, self.surfer, self.it, self.it_t = [], None, 'you', 0.0     # tag
        self.flowers, self.party = [], []                                          # bloomcore
        self.theater, self.audience, self.last_movie = None, [], time.time()       # movie night
        self.planes, self.seen_sends = [], None                                    # paper airplanes
        self.snow = None                                                           # petal snow
        self.game, self.lems, self.lemov = None, [], None                          # lemmings
        self.cascades, self.busy_since = [], {}                                    # solitaire wins
        self.flyers, self.idle_s, self.saver_after = [], 0.0, a.saver * 60         # flying haikus
        self.kaiju, self.last_clippy = None, time.time()
        self.bounce, self.wave, self.last_surprise, self.owl_night, self.haiku_bag = None, None, time.time(), None, []   # rare things
        self.gallery_on, self.gal_gen, self.gal_cast, self.gal_hist, self.placard = False, 0, [], [], None   # peanut gallery
        self.speeches, self.said, self.gal_skip, self.gal_hide, self.gal_why = [], {}, [], [], 'off'
        self.gal_own, self.gal_next = [], 0.0          # ohaiku's own windows (not a change on screen); when the next line may go
        for i in range(a.n): GLib.timeout_add(int(i * 700) + 1, self.add_pet, 'opus0' if a.opus else None)
        GLib.timeout_add(1000 // HZ, self.tick)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, lambda *_: (self.command(), True)[1])
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda *_: (self.quit(), True)[1])
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, lambda *_: (self.quit(), True)[1])
        threading.Thread(target=self.watch, daemon=True).start()
        threading.Thread(target=self.watch_world, daemon=True).start()
        self.tray()

    # -- background watchers: the agents, and whether music is playing ----------------------------------
    def watch(self):
        import agents
        last_music = 0
        while True:
            lk = self.is_locked()
            if lk != self.locked: GLib.idle_add(self.set_locked, lk)
            if lk: time.sleep(2); continue
            try:
                res = agents.scan() if self.show_agents else []
                GLib.idle_add(self.got_agents, res)
            except Exception as e:
                print('ohaiku: scan failed:', e, file=sys.stderr)
            if self.music_on and time.time() - last_music > 2:
                last_music = time.time(); m = self.listen()
                if m != self.music: GLib.idle_add(self.set_music, m)
            time.sleep(1.5)

    def watch_world(self):
        try:
            import world
            W = world.Surfaces()
        except Exception as e:
            print('ohaiku: no recess (python-xlib?):', e, file=sys.stderr); self.world_ok = False; return
        try:
            from Xlib.ext import screensaver as _ss
            W.d.screensaver_query_info(W.root)
            idle = lambda: W.d.screensaver_query_info(W.root).idle / 1000
        except Exception:
            idle = lambda: 0.0
        last_idle = 0
        while True:
            if time.time() - last_idle > 1:
                last_idle = time.time()
                try: GLib.idle_add(self.set_idle, idle())
                except Exception: pass
            if (self.mode in ('recess', 'bloomcore', 'lemmings') or self.snow) and not self.hidden:
                try: GLib.idle_add(self.set_surfaces, W.poll())
                except Exception as e: print('ohaiku: world:', e, file=sys.stderr)
                time.sleep(.12)
            else:
                time.sleep(.5)

    def set_idle(self, v):
        was, self.idle_s = self.idle_s, v
        if self.saver_after > 0 and v > self.saver_after and not self.flyers and not self.hidden and not self.locked: self.flying(True)
        elif self.flyers and v < was and v < 2: self.flying(False)       # you're back: they scatter
        return False

    def set_surfaces(self, s):
        self.surfaces = s; return False

    def is_locked(self):
        if os.environ.get('OHAIKU_IGNORE_LOCK'): return False          # testing on a nested X server
        try:
            out = subprocess.run(['cinnamon-screensaver-command', '-q'], capture_output=True, text=True, timeout=2).stdout
            return 'is active' in out
        except (OSError, subprocess.SubprocessError):
            return False

    def set_locked(self, v):
        self.locked = v
        if v:
            for f in self.flyers: f.win.destroy()
            self.flyers = []
        if self.snow: (self.snow.win.hide() if v else (not self.hidden and self.snow.win.show_all()))
        for c in self.everyone() + ([self.placard] if self.placard else []):
            if v: c.win.hide()
            elif not self.hidden: c.win.show_all()
        if v:
            for b in self.speeches: b.win.destroy()
            self.speeches = []
        return False

    def set_music(self, m):
        self.music = m and self.music_on; return False

    def listen(self):
        try:
            p = subprocess.Popen(['parec', '--device=@DEFAULT_MONITOR@', '--format=s16le', '--rate=8000', '--channels=1',
                                  '--latency-msec=50'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            b = p.stdout.read(3200); p.kill(); p.wait()
            v = array.array('h', b[:len(b) // 2 * 2])
            return len(v) > 0 and math.sqrt(sum(x * x for x in v) / len(v)) > 300
        except OSError:
            return False

    def note_unknown(self, tool):
        if not tool or tool in self.unknown: return
        self.unknown.add(tool)
        try:
            os.makedirs(os.path.dirname(UNKNOWN), exist_ok=True)
            seen = set(open(UNKNOWN).read().split()) if os.path.exists(UNKNOWN) else set()
            if tool not in seen: open(UNKNOWN, 'a').write(tool + '\n')
        except OSError: pass

    def got_agents(self, res):
        ids, new = set(), []
        now = time.time()
        for a in res:
            if a.id in self.dismissed:
                if a.state in ('ask', 'done') and now - a.age > self.dismissed[a.id]: del self.dismissed[a.id]
                else: continue
            ids.add(a.id)
            c = self.agents.get(a.id)
            if c is None:
                wa = self.workarea()
                c = Chibi(self, a.look, wa.x + wa.width - 80, self.floor(), agent=a, scale=.62 if a.kind == 'sub' else .82,
                          label=a.name)
                self.agents[a.id] = c; new.append(c)
            else:
                c.agent = a
                if c.label != a.name:                         # renamed (/rename): new plate
                    c.label, c._plate = a.name, None; c.shape_input(); c.shown = None
        for k, c in list(self.agents.items()):
            if k not in ids: c.leave()
        self.layout()
        self.mail(res)
        now = time.time()
        for a in res:                                     # a long stretch of work just finished: Solitaire's win
            busy = a.state in ('think', 'tool')
            if busy: self.busy_since.setdefault(a.id, now)
            elif a.id in self.busy_since:
                started = self.busy_since.pop(a.id)
                c = self.agents.get(a.id)
                if a.state in ('done', 'free') and now - started >= CASCADE_MIN and c and not self.hidden and not self.locked \
                        and self.studying is None and not self.cascades:
                    self.cascades.append(Cascade(self, c))
        for c in new: c.x = c.slot; c.place()            # bloom where they'll stand
        for a in res:                                     # say what it needs, once, when that starts
            key = (a.state, a.tool) if a.state in ('ask', 'limit', 'error') else None
            if key != self.said.get(a.id):
                self.said[a.id] = key
                c = self.agents.get(a.id)
                if key and c and c.state != 'spawn' and not self.hidden and not self.locked:
                    txt = SAYS.get(a.tool, a.tool or '?') if a.state == 'ask' else ('tea break: %s' % a.tool if a.state == 'limit' else 'oof: %s' % a.tool)
                    self.speak(c, txt, 8.0)
        return False

    # -- where everyone stands ---------------------------------------------------------------------------
    def workarea(self):
        # the pointer's monitor, minus panels (clamped to the monitor: some window managers report odd work areas)
        x, y = self.pointer.get_position()[1:]
        mon = Gdk.Display.get_default().get_monitor_at_point(x, y)
        g, w = mon.get_geometry(), mon.get_workarea()
        r = Gdk.Rectangle()
        r.x, r.y = max(g.x, w.x), max(g.y, w.y)
        root = Gdk.get_default_root_window()
        r.width = min(g.x + g.width, w.x + w.width, root.get_width()) - r.x
        r.height = min(g.y + g.height, w.y + w.height, root.get_height()) - r.y
        return r if r.width > 200 and r.height > 200 else g

    def floor(self):
        wa = self.workarea(); return wa.y + wa.height - LABEL_H

    def order(self):  # (the audience isn't in this: they're in their seats)
        sess = sorted((c for c in self.agents.values() if c.agent.kind == 'session'), key=lambda c: c.agent.born)
        ids = {s.agent.id for s in sess}
        out = []
        for s in sess:
            out.append(s)
            out += sorted((c for c in self.agents.values() if c.agent.kind == 'sub' and c.agent.parent == s.agent.id),
                          key=lambda c: c.agent.born)
        out += [c for c in self.agents.values() if c.agent.kind == 'sub' and c.agent.parent not in ids]
        return out + self.pets

    def layout(self):
        wa = self.workarea(); x = wa.x + wa.width - 60
        for c in self.order():
            w = c.cpx * .7 + 6
            c.slot = x - w / 2; x -= w

    def targets(self, cx, cy):
        if self.mode == 'follow':
            prev = None
            for c in self.order():
                if prev is None: yield c, cx + 26 * c.sc, cy + c.foot * .62
                else: yield c, prev.x - prev.heading * prev.cpx * .5, prev.y
                prev = c
        else:
            fl = self.floor()
            for c in self.order():
                yield c, c.slot + (c.wander if c.work() is None else 0), fl

    def tick(self):
        _, cx, cy = self.pointer.get_position()
        dt = 1 / HZ
        if self.locked: return True
        if self.studying is not None: self.study_tick(dt); return True
        self.detect_shake(cx)
        self.balloons = [b for b in self.balloons if b.tick(dt)]
        self.speeches = [b for b in self.speeches if b.tick(dt)]
        if self.gallery_on: self.gallery_tick(dt)
        self.flowers = [f for f in self.flowers if f.tick(dt)]
        self.planes = [p for p in self.planes if p.tick(dt)]
        self.cascades = [k for k in self.cascades if k.tick(dt)]
        if self.flyers:
            if getattr(self, 'fly_from', None) is None: self.fly_from = (cx, cy)
            elif abs(cx - self.fly_from[0]) + abs(cy - self.fly_from[1]) > 40 and not self.flyers[0].leaving:
                self.flying(False)                        # the pointer moved: you're back, they scatter
            scr = Gdk.Screen.get_default()
            self.flyers = [f for f in self.flyers if f.tick(dt, scr.get_width(), scr.get_height())]
        if self.kaiju:
            if not self.kaiju.tick(dt): self.kaiju = None
        if self.bounce and not self.bounce.tick(dt): self.bounce = None
        if self.wave: self.wave_tick(dt)
        if self.can_surprise():
            for k, every in SURPRISE_EVERY.items():
                if random.random() < dt / every: self.surprise(k); break
            if 1 <= time.localtime().tm_hour < 5 and self.owl_night != time.strftime('%Y-%m-%d') and random.random() < dt / 600:
                self.surprise('owl')
        if self.mode in ('recess', 'bloomcore', 'tag', 'follow') and time.time() - self.last_clippy > 900 and random.random() < dt / 600:
            self.clippy()
        if self.mode in ('recess', 'bloomcore') and not self.kaiju and random.random() < dt / 3600:
            self.stomp()
        if self.snow and not self.hidden and self.tk % 2 == 0:
            self.snow.tick(2 * dt, self.surfaces, self.floor(), self.order())
        if self.theater and not self.hidden: self.audience_tick(dt)
        if self.mode in ('recess', 'bloomcore') and not self.theater and time.time() - self.last_movie > 240 and random.random() < dt / 90:
            self.movie()                                  # it's their playtime; sometimes they put a film on
        if self.mode == 'tag':
            self.tag(cx, cy, dt); self.reap(); self.keep_on_top(); return True
        if self.mode == 'lemmings' and self.game: self.lem_tick(dt)
        fl = self.floor()
        for c, tx, ty in list(self.targets(cx, cy)):
            if c.arc or c.falling: self.air(c, dt)
            elif self.mode in ('recess', 'bloomcore') and c.state != 'spawn': self.recess(c, dt, fl)
            else:
                if self.mode in ('perch', 'lemmings') and c.y < fl - 6 and c.state != 'spawn':     # up on a window: jump down home
                    self.leap(c, c.slot, fl, None)
                else: c.step(dt, tx, ty)
            near = (self.kaiju is not None and abs(self.kaiju.x - c.x) < 500) or self.mode not in ('follow',) and abs(cx - c.x) < c.cpx * .45 + 30 and c.y - c.foot - 30 < cy < c.y + 40
            c.duck += (float(near) - c.duck) * min(1, 8 / HZ)
            if c.duck < .01: c.duck = 0
            c.tick_draw()
        self.reap()
        if os.environ.get('OHAIKU_DEBUG') and self.tk % HZ == 0:
            wa = self.workarea()
            print('wa', wa.x, wa.y, wa.width, wa.height, 'mode', self.mode, [(c.label, c.state, int(c.x), int(c.y), int(c.slot)) for c in self.order()], flush=True)
        self.keep_on_top()
        return True

    def reap(self):
        for k, c in list(self.agents.items()):
            if c.gone: c.win.destroy(); del self.agents[k]
        for c in [p for p in self.pets if p.gone]: c.win.destroy(); self.pets.remove(c)

    def keep_on_top(self):
        self.tk += 1
        if self.tk % (HZ * 2) == 0 and not self.hidden:
            for c in ([self.snow] if self.snow else []) + ([self.lemov] if self.lemov else []) + self.everyone() + self.balloons + self.speeches + ([self.placard] if self.placard else []) + ([self.bounce] if self.bounce else []):
                gw = c.win.get_window()
                if gw: gw.raise_()

    def everyone(self): return list(self.agents.values()) + self.pets + self.audience + self.lems

    # -- movie night ----------------------------------------------------------------------------------------
    def movie(self):
        if self.theater: self.theater.win.close(); return
        wa = self.workarea()
        x = wa.x + 60 + random.uniform(0, max(1, wa.width * .5 - 500))
        y = wa.y + wa.height - 252 - 150 - random.uniform(0, max(1, wa.height * .3))
        self.theater = Theater(self, x, y)
        n = 3
        free = [p for p in self.pets if p is not self.surfer and p.state != 'spawn' and not p.gone][:n]
        for p in free: self.pets.remove(p)
        while len(free) < n:
            if not self.unused: self.unused = list(range(1, 12)); random.shuffle(self.unused)
            free.append(Chibi(self, 'haiku%02d' % self.unused.pop(), x + random.uniform(0, 448), self.floor(), scale=.8))
        for i, c in enumerate(free):
            c.seat, c.seated, c.arc, c.falling, c.on = i, False, None, False, None
            c.next_fidget = time.time() + random.uniform(4, 12)
            self.leap(c, x + 224, y, None); c.arc['t'] = -.5 - i * .35       # one after another, once the window is up
        self.audience = free
        self.last_movie = time.time()
        self.layout()

    def theater_closed(self):
        if self.theater: self.theater.close()
        self.theater = None
        for c in self.audience:                        # "!" and back to whatever everyone else is doing
            c.arc, c.seated = None, False; c.set('alert'); self.pets.append(c)
        self.audience = []
        self.layout()

    # -- Lemmings: "Let's go!" ------------------------------------------------------------------------------
    def lemmings_start(self):
        import world
        wa = self.workarea(); fl = self.floor()
        tops = sorted((x for x in self.surfaces if x.y > wa.y + 170), key=lambda x: x.y)
        if tops:
            t = tops[0]; a, b = max(t.segs, key=lambda q: q[1] - q[0]); ex, ey = (a + b) / 2, t.y - 130
        else:
            ex, ey = wa.x + 220, wa.y + 90
        xx = wa.x + wa.width - 170 if ex < wa.x + wa.width / 2 else wa.x + 170
        self.game = dict(t=0.0, n=10, out=0, saved=0, released=0, entrance=(ex, ey), exit=(xx, fl), bricks=[], next_id=0,
                         last_click=time.time(), director=time.time() + 6, over=None, Surface=world.Surface)
        if not self.lemov: self.lemov = LemOverlay(self)
        GLib.timeout_add(600, lambda: (self.balloon_at(ex, ey, "Let's go!"), False)[1])

    def balloon_at(self, x, y, title):
        class P: pass
        p = P(); p.x, p.y, p.foot, p.gone = x, y + 20, 0, False
        self.balloons.append(Balloon(self, p, title, '', 2.2))

    def lem_release(self):
        G = self.game; ex, ey = G['entrance']
        if not self.unused: self.unused = list(range(1, 12)); random.shuffle(self.unused)
        c = Chibi(self, 'haiku%02d' % self.unused.pop(), ex, ey, scale=.62)
        c.lem = dict(dir=random.choice((-1, 1)), skill=None, mode='fall', vy=0.0, fallh=0.0, timer=0.0, bricks=0, sx0=None)
        c.on = None; c.set('fall'); c.shape_input()
        self.lems.append(c); G['released'] += 1; G['out'] += 1

    def lem_click(self, c, button):
        if not self.game: return
        self.game['last_click'] = time.time()
        self.lem_skill(c, {1: 'builder', 2: 'floater', 3: 'blocker'}.get(button))

    def lem_skill(self, c, sk):
        L = c.lem
        if sk is None or L['skill'] == 'blocker': return
        if sk == 'floater': L['floater'] = True; return            # floating is permanent, like the umbrella
        L['skill'] = sk
        if sk == 'builder': L['bricks'] = 0

    def lem_surfaces(self):
        return self.surfaces + self.game['bricks']

    def lem_tick(self, dt):
        G = self.game; G['t'] += dt
        wa = self.workarea(); fl = self.floor(); S = self.lem_surfaces()
        if G['released'] < G['n'] and G['t'] > 1.2 + G['released'] * 1.1: self.lem_release()
        # the director: if you're not playing, it plays
        if time.time() - G['last_click'] > 10 and time.time() > G['director']:
            G['director'] = time.time() + random.uniform(2.5, 5)
            walkers = [c for c in self.lems if c.lem['mode'] == 'walk' and not c.lem['skill']]
            if walkers:
                c = random.choice(walkers)
                nb = sum(1 for x in self.lems if x.lem['skill'] == 'blocker')
                sk = random.choice(['builder', 'builder', 'floater'] + (['blocker'] if nb < 1 and len(walkers) > 3 else []))
                self.lem_skill(c, sk)
        for c in list(self.lems):
            if c.gone: continue
            L = c.lem; c.t += dt
            if L['mode'] == 'gone':
                if c.state == 'spawn' and c.rev and c.done_anim(): c.gone = True
                c.tick_draw(); continue
            if L['mode'] == 'fall':
                L['vy'] = min(L['vy'] + 1500 * dt, 70 if L.get('floater') else 900)
                ny = c.y + L['vy'] * dt; L['fallh'] += L['vy'] * dt
                land = None
                for sf in S:
                    if c.y <= sf.y <= ny and sf.stands(c.x, 0): land = sf; break
                if land is None and ny >= fl: land = 'floor'
                if land is not None:
                    c.y = fl if land == 'floor' else land.y; c.on = None if land == 'floor' else land.id
                    L['sx0'] = None if land == 'floor' else land.x0
                    if L['fallh'] > 380 and not L.get('floater'): L['mode'], L['timer'] = 'dazed', 1.8; c.set('dizzy')
                    else: L['mode'] = 'walk'
                    L['vy'] = L['fallh'] = 0.0
                else:
                    c.y = ny; c.set('float' if L.get('floater') else 'fall')
            elif L['mode'] == 'dazed':
                L['timer'] -= dt
                if L['timer'] <= 0: L['mode'] = 'walk'
            elif L['mode'] in ('walk', 'build'):
                sf = next((x for x in S if x.id == c.on), None) if c.on is not None else None
                if c.on is not None and (sf is None or not sf.stands(c.x, 0)):
                    L['mode'], L['vy'], L['fallh'] = 'fall', 0.0, 0.0; c.on = None; continue
                if sf is not None:
                    if L['sx0'] is not None: c.x += sf.x0 - L['sx0']
                    L['sx0'] = sf.x0; c.y = sf.y
                else:
                    c.y = fl
                if L['skill'] == 'blocker': c.set('block'); c.tick_draw(); continue
                if L['skill'] == 'builder':
                    L['mode'] = 'build'; c.set('build'); L['timer'] += dt
                    if L['timer'] > .6:
                        L['timer'] = 0.0
                        bx = c.x + L['dir'] * 10; by = c.y - 6
                        G['next_id'] += 1
                        b = G['Surface']('brick%d' % G['next_id'], min(bx, bx + L['dir'] * 26), max(bx, bx + L['dir'] * 26), by,
                                         [(min(bx, bx + L['dir'] * 26), max(bx, bx + L['dir'] * 26))])
                        G['bricks'].append(b)
                        c.x += L['dir'] * 13; c.y = by; c.on = b.id; L['sx0'] = b.x0
                        L['bricks'] += 1
                        if L['bricks'] >= 12: L['skill'] = None; L['mode'] = 'walk'; self.balloon(c, '*shrug*', '', 1.2)
                    c.tick_draw(); continue
                L['mode'] = 'walk'
                nx = c.x + L['dir'] * 52 * c.sc / .62 * dt
                for o in self.lems:                                  # a blocker turns you round
                    if o is not c and o.lem['skill'] == 'blocker' and o.on == c.on and abs(o.y - c.y) < 8 and 0 < (o.x - c.x) * L['dir'] < 22:
                        L['dir'] *= -1; nx = c.x; break
                if nx < wa.x + 16 or nx > wa.x + wa.width - 16: L['dir'] *= -1; nx = c.x
                step = next((x for x in G['bricks'] if x.id != c.on and 0 < c.y - x.y <= 8 and x.stands(nx, 0)), None)
                if step: c.on = step.id; L['sx0'] = step.x0; c.y = step.y                    # up the stairs
                elif sf is not None and not sf.stands(nx, 0):
                    c.x = nx; L['mode'], L['vy'], L['fallh'] = 'fall', 0.0, 0.0; c.on = None; continue
                c.x = nx; c.set('runR' if L['dir'] > 0 else 'runL')
                if c.on is None and abs(c.x - G['exit'][0]) < 12:          # home!
                    L['mode'] = 'gone'; G['saved'] += 1; G['out'] -= 1; c.leave()
            c.tick_draw()
        self.lems = [c for c in self.lems if not (c.gone and (c.win.destroy() or True))]
        if G['released'] == G['n'] and not self.lems and not G.get('over'):
            G['over'] = 'ALL OUT.  SAVED %d%%' % (100 * G['saved'] // G['n'])
            GLib.timeout_add(5000, lambda: (self.mode == 'lemmings' and self.set_mode('perch'), False)[1])
        if self.lemov and self.tk % 2 == 0: self.lemov.win.queue_draw()

    def oh_no(self):
        """Lemmings' nuke: everyone says "Oh no!" and pops"""
        if not self.game: return
        self.game['n'] = self.game['released']
        for c in self.lems:
            if c.lem['mode'] != 'gone':
                self.balloon(c, 'Oh no!', '', 1.4); c.lem['mode'] = 'gone'; c.set('fall')
                GLib.timeout_add(int(1300 + random.uniform(0, 500)), lambda c=c: (c.leave(), False)[1])

    def lemmings_end(self):
        for c in self.lems: c.win.destroy()
        self.lems, self.game = [], None
        if self.lemov: self.lemov.win.destroy(); self.lemov = None

    def toggle_snow(self, on=None, kind='petals'):
        on = (self.snow is None or self.snow.kind != kind) if on is None else on
        if on and self.snow and self.snow.kind != kind: self.snow.win.destroy(); self.snow = None     # petals <-> leaves
        if on and not self.snow: self.snow = Snow(self, kind)
        elif not on and self.snow: self.snow.win.destroy(); self.snow = None
        if not on and self.mode not in ('recess', 'bloomcore'): self.surfaces = []
        return False

    def flying(self, on):
        if on:
            scr = Gdk.Screen.get_default(); W, H = scr.get_width(), scr.get_height()
            for i in range(14):
                sc = random.choice((.55, .7, .85, 1.0))
                self.flyers.append(Flyer(self, 'haiku%02d' % random.randrange(12), random.uniform(W * .2, W + 300),
                                         random.uniform(-400, H * .6), sc))
        else:
            for f in self.flyers: f.leaving = True
        self.fly_from = None

    def stomp(self):
        if self.kaiju or not os.path.isdir(os.path.join(SHARE, 'kaiju')): return
        self.kaiju = Kaiju(self, random.choice(('opus0', 'opus3')))
        hiders = self.order()
        if hiders: self.balloon(random.choice(hiders), 'KAIJU!', '', 2.0)

    # -- rare things, found by accident ---------------------------------------------------------------------
    def can_surprise(self):
        return not (self.hidden or self.locked or self.studying is not None or self.gallery_on or self.theater or self.bounce or self.wave
                    or self.cascades or self.kaiju or self.mode in ('tag', 'lemmings') or self.idle_s > 30
                    or time.time() - self.last_surprise < 1200)

    def floorers(self):
        fl = self.floor()
        return [c for c in self.order() if c.state != 'spawn' and not c.arc and not c.falling and abs(c.y - fl) < 8 and not c.gone]

    def surprise(self, k):
        free = [c for c in self.floorers() if c.work() is None and c.state not in ('sleep', 'yawn')]
        if k == 'haiku' and free:
            h, mon = time.localtime().tm_hour, time.localtime().tm_mon
            ok = {None: True, 'fall': mon in (9, 10, 11), 'night': h >= 22 or h < 4, 'morning': 6 <= h < 10}
            if not self.haiku_bag: self.haiku_bag = HAIKU[:]; random.shuffle(self.haiku_bag)
            while self.haiku_bag:                         # (one that's out of season waits for the next round)
                w, t = self.haiku_bag.pop()
                if ok[w]: self.speak(random.choice(free), t, 11.0, wrap=40); break
        elif k == 'wave' and len(self.floorers()) >= 4 and self.mode == 'perch':
            row = sorted(self.floorers(), key=lambda c: c.x)
            if random.random() < .5: row.reverse()
            self.wave = dict(t=0.0, row=row)
        elif k == 'dvd' and any(not (c.agent and c.agent.kind == 'sub') for c in free):
            self.bounce = Bounce(self, random.choice([c for c in free if not (c.agent and c.agent.kind == 'sub')]))
        elif k == 'owl' and free:
            self.owl_night = time.strftime('%Y-%m-%d')
            c = random.choice(free)
            self.balloon(c, "It looks like it's %s a.m." % time.strftime('%-I:%M'), 'Would you like help going to bed?', 7.0)
            GLib.timeout_add(2500, lambda: (not c.gone and c.work() is None and c.set('yawn'), False)[1])
        else: return
        self.last_surprise = time.time()

    def wave_tick(self, dt):
        """the stadium wave along the bottom edge: there, and back"""
        W = self.wave; W['t'] += dt; row = W['row']
        gap, up = .15, .6
        lap = gap * (len(row) - 1) + up
        for i, c in enumerate(row):
            h = 0.0
            for t0 in (i * gap, lap + .5 + (len(row) - 1 - i) * gap):
                k = (W['t'] - t0) / up
                if 0 <= k <= 1: h = math.sin(math.pi * k)
            c.hop = h * c.cpx * .32
            if h > .2 and c.work() is None: c.cheer = time.time() + .25
        if W['t'] > 2 * lap + .6:
            for c in row: c.hop = 0.0
            self.wave = None

    def corner(self, b):
        """the DVD logo hit the corner: everyone loses it"""
        fans = [c for c in self.floorers() if c is not b.c]
        for c in fans:
            if c.work() is None: c.cheer = time.time() + 3.5
        if fans: self.speak(random.choice(fans), random.choice(('THE CORNER!!', 'IT HIT THE CORNER', 'corner!! CORNER!!')), 3.5)

    def clippy(self):
        self.last_clippy = time.time()
        try:
            out = subprocess.run(['xprop', '-root', '_NET_ACTIVE_WINDOW'], capture_output=True, text=True, timeout=1).stdout
            wid = out.strip().split()[-1]
            title = subprocess.run(['xprop', '-id', wid, '_NET_WM_NAME'], capture_output=True, text=True, timeout=1).stdout
            title = title.split('=', 1)[1].strip().strip('"') if '=' in title else ''
        except (OSError, subprocess.SubprocessError, IndexError):
            title = ''
        import re
        head, body = next(b for pat, b in CLIPPY if re.search(pat, title or 'x'))
        speakers = [c for c in self.order() if c.state not in ('spawn', 'sleep') and not c.arc and not c.falling]
        if speakers: self.balloon(random.choice(speakers), head, body, 6.0)

    def mail(self, res):
        """new SendMessage calls become paper airplanes (the first scan only remembers what was already sent)"""
        first = self.seen_sends is None
        if first: self.seen_sends = set()
        for a in res:
            for sid, to, ts in getattr(a, 'sends', []):
                if sid in self.seen_sends: continue
                self.seen_sends.add(sid)
                src = self.agents.get(a.id)
                if first or not src or self.hidden: continue
                self.planes.append(Plane(self, src, self.addressee(to)))

    def addressee(self, to):
        cs = [c for c in self.agents.values() if c.agent and not c.gone]
        if to.startswith('uds:'):
            try: pid = int(os.path.basename(to).split('.')[0])
            except ValueError: return None
            return next((c for c in cs if c.agent.pid == pid), None)
        if len(to) == 17 and to[0] == 'a': return next((c for c in cs if c.agent.id == 'agent-' + to), None)
        return next((c for c in cs if to in (c.agent.names or []) or to == c.agent.name), None) or \
            next((c for c in cs if to.lower() == c.agent.name.lower()), None)

    def audience_tick(self, dt):
        T = self.theater
        T.tick(dt)
        seats = T.seats(len(self.audience))
        if not seats: return
        now = time.time()
        for c in self.audience:
            sx, sy = seats[c.seat]
            if not c.seated:
                if c.arc:
                    c.arc['x1'], c.arc['y1'] = sx, sy
                    A = c.arc; A['t'] += dt; k = max(0, min(1, A['t'] / A['T']))
                    c.x = A['x0'] + (A['x1'] - A['x0']) * k; c.y = A['y0'] + (A['y1'] - A['y0']) * k - A['h'] * 4 * k * (1 - k)
                    c.t += dt
                    if k >= 1: c.arc = None
                else:
                    c.seated = True; c.set('watch')
            else:
                c.x, c.y = sx, sy; c.t += dt
                if c.state == 'whisper' and c.done_anim(): c.set('watch')
                if now > c.next_fidget:
                    c.next_fidget = now + random.uniform(4, 12)
                    c.set(random.choice(('watch', 'watch', 'munch', 'giggle', 'whisper')))
            c.duck = 0
            c.tick_draw()

    def speak(self, c, text, life=5.0, pick=False, thumb=None, wrap=30):
        self.speeches = [b for b in self.speeches if not (b.who is c and (b.win.destroy() or True))]
        self.speeches.append(Speech(self, c, text, life, pick, thumb, wrap))

    def drop_pick(self):
        """the gallery's standing request goes when the screen changes (or the gallery stops)"""
        self.pick_gen = getattr(self, 'pick_gen', 0) + 1           # (and one still on its way is called off)
        self.speeches = [b for b in self.speeches if not (b.pick and (b.win.destroy() or True))]

    # -- the Peanut Gallery: they watch your screen, and Haiku does the voices ------------------------------
    def gallery_seats(self):
        return self.gallery_on and self.mode == 'perch' and not self.hidden

    def cast_name(self, c):
        if c.label: return c.label
        if not getattr(c, 'castname', None):
            n = int(''.join(ch for ch in c.who if ch.isdigit()) or 0)
            base = 'Opus' if c.who.startswith('opus') else KINDS[n % 12]
            taken = {getattr(o, 'castname', None) for o in self.everyone()}
            nm, i = base, 2
            while nm in taken: nm, i = '%s %d' % (base, i), i + 1
            c.castname = nm
        return c.castname

    def cast_map(self):
        """who's watching: the free ones in the row (perch), and the theater's audience"""
        m, skip = {}, self.gal_skip
        if self.mode == 'perch':
            for c in self.order():
                if c.gone or c.state == 'spawn' or (c.agent is not None and c.work() is not None): continue
                if c.agent is not None and any(k in (c.agent.name + ' ' + c.agent.cwd).lower() for k in skip): continue   # not in the cast
                m[self.cast_name(c)] = c
        for c in self.audience: m[self.cast_name(c)] = c
        return m

    def gallery(self, on=None):
        on = not self.gallery_on if on is None else on
        if on == self.gallery_on: return
        self.gallery_on = on; self.gal_gen += 1
        if on:
            if self.mode != 'perch': self.set_mode('perch')            # the gallery is its own tier: everyone sits down
            if self.hidden: self.set_mode('show')
            import gallery; self.gal_hist, self.gal_skip = [], gallery.skip_words()
            self.gal_why = 'settling in'
            self.placard = Placard(self)
            threading.Thread(target=self.gallery_loop, args=(self.gal_gen,), daemon=True).start()
        else:
            if self.placard: self.placard.win.destroy(); self.placard = None
            self.drop_pick()
            for c in self.everyone():
                if c.state.startswith('g'): c.set('alert')
        if getattr(self, 'gal_item', None) and self.gal_item.get_active() != on:
            self.menu_lock = True; self.gal_item.set_active(on); self.menu_lock = False

    def gallery_tick(self, dt):
        if self.tk % (HZ * 10) == 0:
            import gallery; self.gal_skip = gallery.skip_words()
        if self.tk % 6 == 0:                               # skipped sessions' own chibis and plates: blacked out too
            self.gal_hide = [(int(c.x - c.W / 2) - 4, int(c.y - c.foot) - 4, c.W + 8, c.H + 8) for c in self.agents.values()
                             if any(k in (c.agent.name + ' ' + c.agent.cwd).lower() for k in self.gal_skip)]
        if self.tk % 6 == 3:                               # and our own windows: a new bubble isn't something new on screen
            try: self.gal_own = [tuple(o.win.get_position()) + tuple(o.win.get_size()) for o in self.everyone() + self.speeches
                                 + self.balloons + ([self.placard] if self.placard else []) if o.win.get_visible()]
            except Exception: self.gal_own = []
        if self.tk % HZ == 0:
            self.gal_cast = [(n, 'Opus 5.5' if c.who.startswith('opus') else 'Haiku 5.5') for n, c in self.cast_map().items()]
        if self.placard:
            row = [c for c in self.order() if not c.gone]
            x = min([c.slot - c.cpx * .45 for c in row] + [self.workarea().x + self.workarea().width - 40]) - 8
            self.placard.tick(dt, x, self.floor() + LABEL_H - 1)

    def gallery_loop(self, gen):
        import gallery, world
        S = world.Surfaces()
        W, H = S.d.screen().width_in_pixels, S.d.screen().height_in_pixels
        watch = gallery.Watch(W, H)                 # a tiny grey thumbnail of the screen, twice a second
        last_thumb, last_sent, hist, wait = None, 0.0, self.gal_hist, GAL_GAP
        recent = collections.deque(maxlen=3)        # the last few thumbnails (to tell when the screen has settled)
        moved = None                                # since when the screen has looked different from the last look
        soon = False                                # look as soon as we may (the page they asked about has gone)
        wants, log = [], []
        showing, since = None, time.time()          # what's in front (window and title), and since when
        pick_on = None                              # what was in front when they asked for something
        live = lambda: self.gallery_on and self.gal_gen == gen
        try:
            while live():
                time.sleep(.5)
                why = ('hidden' if self.hidden else 'screen locked' if self.locked else 'studying' if self.studying is not None
                       else 'nobody free to watch' if not self.gal_cast else None)
                if why: self.gal_why = why; continue
                if not watch.alive(): watch = gallery.Watch(W, H)
                th = watch.frame()
                if th is None: continue
                try:
                    wins, act = S.windows(), S.active()
                except Exception: continue
                now_on = next(((w[0], w[6]) for w in wins if w[0] == act), None)
                if now_on != showing: showing, since = now_on, time.time()
                if pick_on is not None and now_on != pick_on:      # their request goes the moment the page changes
                    pick_on, soon = None, True; GLib.idle_add(lambda: (self.drop_pick(), False)[1])
                hide = gallery.private_rects(wins) + list(self.gal_hide) + list(self.gal_own)
                d = gallery.changed(th, last_thumb, hide, W, H)
                still = len(recent) == recent.maxlen and gallery.changed(th, recent[0], hide, W, H) < 1.0
                recent.append(th)
                if d < 2.0: moved = None
                elif moved is None: moved = time.time()
                if time.time() - last_sent < wait: continue
                if not (soon or time.time() - last_sent > GAL_IDLE or (moved and (still or time.time() - moved > 2.5))):
                    self.gal_why = 'watching (%s)' % ('waiting for the screen to settle' if moved else 'nothing new on screen'); continue
                try:
                    imgs, _ = gallery.capture(W, H, gallery.private_rects(wins) + list(self.gal_hide), gallery.focus_rect(wins, act, W, H))
                except Exception as e:
                    print('ohaiku: gallery capture:', e, file=sys.stderr); last_sent, wait = time.time(), 60
                    self.gal_why = 'screenshot failed: %s' % str(e)[:80]; continue
                last_thumb, last_sent, wait, moved, soon = th, time.time(), GAL_GAP, None, False
                self.gal_why = 'looking...'
                GLib.idle_add(lambda: (self.placard and setattr(self.placard, 'blink', 1.0), False)[1])
                try:
                    res = gallery.look(imgs, list(self.gal_cast), hist, int((time.time() - since) / 60),
                                       on_riff=lambda r: GLib.idle_add(self.gallery_riff, r, gen))
                except Exception as e:
                    print('ohaiku: gallery:', e, file=sys.stderr); wait = 60
                    self.gal_why = 'Haiku call failed: %s' % str(e)[:80]; continue
                if not live(): break
                pick_on = showing if res.get('pick') else None
                self.gal_why, self.gal_looks = 'watching (last look %s)' % time.strftime('%H:%M:%S'), getattr(self, 'gal_looks', 0) + 1
                hist.append('%s seen: %s' % (time.strftime('%H:%M'), res['seen']) + ''.join(' | %s: "%s"' % (r['who'], r['line']) for r in res['riffs'])
                            + (' | noted: %s' % res['note'] if res['note'] else '') + (' | wished for: %s' % res['want']['what'] if res['want'] else '')
                            + (' | asked to watch: %s' % res['pick']['title'] if res.get('pick') else ''))
                if res['want']: wants.append(res['want'])
                log.append(hist[-1] + (' | detail: %s' % res['detail'] if res['detail'] else ''))
                try:
                    shot = ''
                    if res['note'] or res['want']:                # keep the look itself (redacted) when it was worth a note
                        shot = '\n\n![](%s)' % gallery.keep(imgs[-1])
                    gallery.write('**%s** %s' % (time.strftime('%H:%M'), res['seen']) + ('\n\n%s' % res['detail'] if res['detail'] else '')
                                  + ''.join('\n> **%s:** %s' % (r['who'], r['line']) for r in res['riffs'])
                                  + ('\n\n\u25b6 **%s** asks for *%s*: %s' % (res['pick']['who'] or 'someone', res['pick']['title'], res['pick']['line']) if res.get('pick') else '')
                                  + ('\n\n\u270e %s' % res['note'] if res['note'] else '')
                                  + ('\n\n\u2606 wish: %s (%s)%s' % (res['want']['what'], res['want']['why'], ' \u2014 ' + res['want']['where'] if res['want']['where'] else '') if res['want'] else '')
                                  + shot)
                except OSError: pass
                GLib.idle_add(self.gallery_result, res)
        finally:
            watch.close()
        if self.gal_gen == gen + 1 and not self.gallery_on and len(log) >= 3:       # turned off (not quit): a recap for the notebook
            try:
                rc = gallery.recap(log)
                gallery.write('## Recap, %s\n\n%s' % (time.strftime('%H:%M'), rc))
                gallery.to_inspo(rc, gallery.pick_wishes(wants))
            except Exception as e: print('ohaiku: gallery recap:', e, file=sys.stderr)

    def gal_say(self, c, pose, line, thumb=None, pick=False, stale=None):
        """a line from the gallery, in turn: GAL_SPACE s after the one before. A riff that would have to wait more than
        `stale` s is dropped (the screen has moved on)"""
        now = time.time(); t = max(now, self.gal_next)
        if stale is not None and t - now > stale: return
        self.gal_next = t + GAL_SPACE
        if pick:
            g = getattr(self, 'pick_gen', 0)
            GLib.timeout_add(int((t - now) * 1000) + 1, lambda: self.riff(c, pose, line, True, thumb) if getattr(self, 'pick_gen', 0) == g else False)
        else: GLib.timeout_add(int((t - now) * 1000) + 1, self.riff, c, pose, line, False, thumb)

    def gallery_riff(self, r, gen):
        """a riff the moment it has streamed in"""
        if self.gal_gen != gen or not self.gallery_on: return False
        self.drop_pick()
        c = self.cast_map().get(r['who'])
        if c: self.gal_say(c, r['pose'], r['line'], r.get('thumb'), stale=6)
        return False

    def gallery_result(self, res):
        self.drop_pick()
        cast = self.cast_map()
        for r in res['riffs']:
            if not r.get('shown') and cast.get(r['who']): self.gal_say(cast[r['who']], r['pose'], r['line'], r.get('thumb'), stale=6)
        if res['want'] and cast:                    # say the wish out loud, so Mark hears what they'd love to see
            self.gal_say(random.choice(list(cast.values())), 'cheer', 'can we get ' + clip(res['want']['what'], 80) + '?')
        if res['note'] and cast:
            self.gal_say(random.choice(list(cast.values())), 'whisper', 'noted: ' + clip(res['note'], 84))
        if res.get('pick') and cast:                 # their request: stays up until the screen changes
            c = cast.get(res['pick']['who']) or random.choice(list(cast.values()))
            self.gal_say(c, 'cheer', res['pick']['line'], res['pick'].get('thumb'), pick=True)
        return False

    def riff(self, c, pose, line, pick=False, thumb=None):
        if c.gone or self.hidden or self.locked or (pick and not self.gallery_on): return False
        life = 3.2 + len(line) / 16 + (1.5 if thumb else 0)
        if c in self.audience:
            c.set({'gasp': 'giggle', 'cheer': 'giggle'}.get(pose, pose)); c.next_fidget = time.time() + life
        else:
            c.react = (pose, time.time() + min(life, 4.5))
        self.speak(c, line, float('inf') if pick else life, pick, thumb)
        return False

    def balloon(self, c, title, body='', life=4.0):
        self.balloons = [b for b in self.balloons if not (b.who is c and (b.win.destroy() or True))]
        self.balloons.append(Balloon(self, c, title, body, life))

    # -- tag: one Haiku surfs your pointer, the rest run; touch one and it's It -----------------------------
    def tag(self, cx, cy, dt):
        wa = self.workarea(); u = self.surfer.sc * self.surfer.m['cell'] / 400 if self.surfer else 0
        if self.surfer is None or self.surfer.gone:
            free = [p for p in self.pets if not p.gone and p.state != 'spawn']
            if free: self.surfer = free[0]
            else: self.surfer = Chibi(self, 'haiku00', cx, cy); self.pets.append(self.surfer); self.layout()
            self.surfer.arc = None; self.surfer.falling = False
            self.surfer.set('surf'); self.balloon(self.surfer, 'Cursor is now connected', 'Partner: Haiku 5.5\nSpeed: 54.0 Mbps', 4)
        S = self.surfer
        S.x, S.y = cx + 120 * S.sc * S.m['cell'] / 400, cy + 3; S.duck = 0
        if S.state != 'surf': S.set('surf')
        S.t += dt; S.tick_draw()
        self.it_t += dt
        it = self.it if (self.it == 'you' or (self.it in self.everyone() and not self.it.gone)) else 'you'
        self.it = it
        for c in self.order():
            if c is S or c.state == 'spawn': continue
            if c.arc or c.falling: self.air(c, dt); c.tick_draw(); continue
            dx, dy = c.x - cx, (c.y - c.foot * .5) - cy
            d = math.hypot(dx, dy) or 1
            if it == 'you':
                if d < c.cpx * .32 and self.it_t > 1.0:                          # tagged!
                    self.it, self.it_t = c, 0.0; c.set('done')
                    self.balloon(c, "I'm it!", '', 2.5); break
                if d < 340:
                    tx = c.x + dx / d * 260 + (-dy / d * 160 if abs(dx) < 40 else 0); ty = c.y + dy / d * 200
                else:
                    tx, ty = c.x, c.y
                x0, x1 = wa.x + 50, wa.x + wa.width - 50
                y0, y1 = wa.y + c.foot + 10, wa.y + wa.height - LABEL_H
                if not x0 <= tx <= x1:                                  # cornered against a side: slip along it
                    ty += 260 if c.y - cy >= 0 and c.y + 260 < y1 else -260
                if not y0 <= ty <= y1:                                  # against the top or bottom: slip sideways
                    tx += 300 if (c.x - cx >= 0 and c.x + 300 < x1) or c.x - 300 < x0 else -300
                for o in self.everyone():                               # don't pile up
                    if o is not c and abs(o.x - c.x) < 50 and abs(o.y - c.y) < 50: tx += (c.x - o.x or 1) * 2
                tx = min(max(tx, x0), x1); ty = min(max(ty, y0), y1)
                c.speed = 430 * c.sc
            elif c is it:
                tx, ty = cx - 30, cy + c.foot * .55; c.speed = 520 * c.sc
                if d < c.cpx * .3 and self.it_t > 1.2:                          # tagged you back
                    self.it, self.it_t = 'you', 0.0; c.set('done')
                    self.balloon(c, 'Tag! You\'re it!', '', 2.5)
                    tx, ty = c.x, c.y
            else:
                tx, ty = c.x, c.y                                                # safe: cheer and dance
            c.step(dt, tx, ty)
            c.tick_draw()


    # -- recess: the windows are the playground ------------------------------------------------------------
    def surface(self, sid):
        return next((s for s in self.surfaces if s.id == sid), None)

    def leap(self, c, x1, y1, sid):
        d = math.hypot(x1 - c.x, y1 - c.y)
        c.arc = dict(x0=c.x, y0=c.y, x1=x1, y1=y1, sid=sid, t=0.0, T=.45 + d / 1400, h=60 + .25 * d)
        c.goal = None; c.set('leap')

    def land(self, c, sid, y):
        c.arc, c.falling, c.vy = None, False, 0.0
        c.on, c.y = sid, y
        s = self.surface(sid) if sid else None
        c.off = c.x - s.x0 if s else 0.0
        c.rest, c.extra = 0.0, None; c.set('idle')
        if self.mode == 'bloomcore':
            self.flowers.append(Flower(self, c.x + random.uniform(-26, 26), y, random.randrange(12)))
            while len(self.flowers) > 40: self.flowers.pop(0).win.destroy()

    def erupt(self, n=10):
        """Bloomcore: a burst of Haikus out of the tray, each flying to a window top"""
        tx, ty = self.tray_point(); wa = self.workarea(); fl = self.floor()
        for i in range(n):
            if not self.unused: self.unused = list(range(1, 12)); random.shuffle(self.unused)
            c = Chibi(self, 'haiku%02d' % self.unused.pop(), min(tx, wa.x + wa.width - 40), min(ty, fl))
            self.pets.append(c); self.party.append(c)
            spots = [x for x in self.surfaces if x.y > wa.y + c.cpx * .9]
            if spots and random.random() < .75:
                t = random.choice(spots); a, b = random.choice(t.segs); self.leap(c, random.uniform(a + 30, b - 30), t.y, t.id)
            else:
                self.leap(c, random.uniform(wa.x + 60, wa.x + wa.width - 60), fl, None)
            c.arc['t'] = -i * .12                         # one after another
        self.layout()
        if not self.quiet:
            try: subprocess.Popen(['paplay', '--volume=26000', os.path.join(HERE, 'ding.wav')], stderr=subprocess.DEVNULL)
            except OSError: pass

    def air(self, c, dt):
        fl = self.floor()
        if c.arc:
            A = c.arc; A['t'] += dt; k = max(0, min(1, A['t'] / A['T']))
            c.x = A['x0'] + (A['x1'] - A['x0']) * k
            c.y = A['y0'] + (A['y1'] - A['y0']) * k - A['h'] * 4 * k * (1 - k)
            if A['x1'] != A['x0']: c.heading = 1 if A['x1'] > A['x0'] else -1
            c.t += dt
            if k >= 1:
                s = self.surface(A['sid']) if A['sid'] else None
                if A['sid'] and (s is None or not s.stands(c.x)): c.arc = None; c.falling = True; c.set('fall')
                else: self.land(c, A['sid'], s.y if s else fl)
            return
        c.vy += 2600 * dt; ny = c.y + c.vy * dt; c.t += dt
        for s in (self.surfaces if self.mode in ('recess', 'bloomcore') else []):
            if s.stands(c.x) and c.y <= s.y <= ny: self.land(c, s.id, s.y); return
        if ny >= fl: self.land(c, None, fl); return
        c.y = ny

    def recess(self, c, dt, fl):
        wa = self.workarea()
        s = self.surface(c.on) if c.on else None
        if c.on and (s is None or not s.stands(c.x)):                   # its window moved away, closed, or got covered
            c.on = None; c.falling, c.vy = True, -250.0; c.set('fall'); return
        if s: c.x, c.y = s.x0 + c.off, s.y                              # ride along when the window moves
        else: c.y = fl
        now = time.time()
        free = c.work() is None
        if c.next_hop is None: c.next_hop = now + random.uniform(.3, 3)
        if now > c.next_hop and c.state not in ('sleep', 'yawn', 'wake', 'alert') and (free or not c.settled):
            c.settled = True
            c.next_hop = now + ((random.uniform(2, 5) if self.mode == 'bloomcore' else random.uniform(5, 14)) if free else 1e12)
            spots = [x for x in self.surfaces if x.y > wa.y + c.cpx * .9]
            if spots and random.random() < .8:
                t = random.choice(spots); a, b = random.choice(t.segs); x = random.uniform(a + 30, b - 30); y, sid = t.y, t.id
            else:
                x, y, sid = random.uniform(wa.x + 60, wa.x + wa.width - 60), fl, None
            if sid == c.on and abs(x - c.x) < 500: c.goal = x
            else: self.leap(c, x, y, sid); return
        tx = c.goal if c.goal is not None else c.x
        c.step(dt, tx, c.y)
        if c.goal is not None and abs(c.x - c.goal) < 3: c.goal = None
        if s: c.off = c.x - s.x0

    # -- "Nothing! Studying!": shake the mouse and they're all vacuumed into the tray --------------------------
    def detect_shake(self, cx):
        now = time.time()
        self.shake.append((now, cx)); self.shake = [p for p in self.shake if now - p[0] < .7]
        flips, last = 0, 0
        for (t0, x0), (t1, x1) in zip(self.shake, self.shake[1:]):
            dx = x1 - x0
            if abs(dx) < 14: continue
            sg = 1 if dx > 0 else -1
            if last and sg != last: flips += 1
            last = sg
        if flips >= 5 and not self.hidden and self.everyone(): self.study()

    def tray_point(self):
        try:
            ok, scr, area, orient = self.icon.get_geometry()
            if ok and area.width > 1 and (area.x > 0 or area.y > 0): return area.x + area.width / 2, area.y + area.height / 2
        except Exception: pass
        wa = self.workarea(); return wa.x + wa.width - 30, wa.y + wa.height + 10

    def study(self):
        if self.studying is not None: return
        self.studying = 0.0; self.shake = []
        self.vac_to = self.tray_point()
        self.gallery(False)                               # (and stop looking at the screen)
        for b in self.speeches: b.win.destroy()
        self.speeches = []
        if self.theater: self.theater.win.hide()
        if self.bounce: self.bounce.win.destroy(); self.bounce.c.win.show_all(); self.bounce = None
        if self.wave:
            for c in self.wave['row']: c.hop = 0.0
            self.wave = None
        for c in self.everyone():
            c.arc, c.falling, c.goal = None, False, None
            c.vac_from = (c.x, c.y); c.vac_delay = random.uniform(0, .12)

    def study_tick(self, dt):
        t0 = self.studying; t = self.studying = t0 + dt
        tx, ty = self.vac_to
        if t0 < .5:
            for c in self.everyone():
                k = min(1, max(0, (t - c.vac_delay) / .36)); kk = k * k
                c.x = c.vac_from[0] + (tx - c.vac_from[0]) * kk
                c.y = c.vac_from[1] + (ty + c.foot * .3 - c.vac_from[1]) * kk
                c.shrink = max(.04, 1 - kk); c.spin = kk * 7 * (1 if c.heading > 0 else -1)
                c.set('fall'); c.t += dt; c.tick_draw()
            if t >= .5:                                   # slam: all gone
                for c in self.pets: c.win.destroy()
                for f in self.flowers: f.win.destroy()
                for c in self.audience: c.win.destroy()
                if self.theater: self.theater.close(); self.theater.win.destroy(); self.theater = None
                self.toggle_snow(False)
                self.lemmings_end()
                for f in self.flyers: f.win.destroy()
                self.flyers = []
                if self.kaiju: self.kaiju.win.destroy(); self.kaiju = None
                self.pets, self.party, self.flowers, self.audience = [], [], [], []
                fl = self.floor()
                for c in self.agents.values():
                    c.win.hide(); c.shrink, c.spin = 1.0, 0.0
                    c.x, c.y, c.on, c.next_hop, c.settled = c.slot, fl, None, None, False; c.set('idle')
                self.hidden, self.mode = True, 'perch'; self.sync_menu()
        elif t >= 3.0 and self.peeker is None:            # ...one peeks back out, and dings
            wa = self.workarea()
            self.peeker = Chibi(self, 'haiku00', max(wa.x + 60, min(tx - 50, wa.x + wa.width - 60)), self.floor())
            self.peeker.duck = 1.0; self.peeker.set('cat'); self.peeker.win.show_all()
            self.dinged = False
        elif self.peeker is not None:
            P = self.peeker; P.t += dt; u = t - 3.0
            P.duck = 1 - .62 * min(1, u / .25) if u < 1.6 else .38 + .62 * min(1, (u - 1.6) / .25)
            P.tick_draw()
            if u > 1.9:
                P.win.destroy(); self.peeker = None; self.studying = None

    def focus(self, c):
        """raise the terminal window this session runs in (Claude Code titles it after the session); else Claude Desktop"""
        a = c.agent
        if a is None: return
        if a.kind == 'sub':
            parent = self.agents.get(a.parent)
            if parent: a = parent.agent
        names = set(a.names or [a.name])
        try:
            wins = subprocess.run(['wmctrl', '-l'], capture_output=True, text=True, timeout=2).stdout.splitlines()
        except (OSError, subprocess.SubprocessError):
            wins = []
        for ln in wins:
            parts = ln.split(None, 3)
            if len(parts) < 4: continue
            title = parts[3]
            if title[:1] and not title[0].isalnum(): title = title[1:].strip()      # Claude Code's ✳ / spinner
            if title in names:
                subprocess.Popen(['wmctrl', '-i', '-a', parts[0]]); return
        # not in a terminal here: the Desktop app's "Sessions Waiting for You" (opens it if it's closed)
        url = 'claude://code/needs-input?source=desktop_action' if a.state in ('ask', 'done', 'free') else 'claude://code/continue?session=last&source=desktop_action'
        try: subprocess.Popen(['xdg-open', url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError: pass

