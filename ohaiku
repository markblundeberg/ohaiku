        G = self.app.game
        cr.set_operator(cairo.OPERATOR_SOURCE); cr.set_source_rgba(0, 0, 0, 0); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER)
        if not G: return True
        ex, ey = G['entrance']; op = min(1, G['t'] / .8)
        cr.set_source_rgb(.42, .27, .15); cr.rectangle(ex - 46, ey - 14, 92, 16); cr.fill()               # the hatch
        cr.set_source_rgb(.3, .18, .1)
