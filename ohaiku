class Snow:
    """xsnow, bloomcore edition: petals drift down the screen and pile up on window tops and the bottom edge.
    kind='leaves': autumn, with maple, ginkgo and aspen leaves fluttering down in a gusty wind that blows the drifts off"""

    def __init__(self, app, kind='petals'):
        self.app, self.kind = app, kind
        self.wind, self.gust, self.prevail = 0.0, None, random.choice((-1, 1))
        self.falling, self.piles, self.tops, self.t = [], {}, {}, 0.0   # piles: surface id (None = floor) -> [[dx, y, rot, col]]
        w = self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
        w.set_app_paintable(True)
        vis = w.get_screen().get_rgba_visual()
        if vis: w.set_visual(vis)
        scr = Gdk.Screen.get_default(); self.W, self.H = scr.get_width(), scr.get_height()
        w.resize(self.W, self.H); w.move(0, 0)
        w.connect('draw', self.draw)
        w.connect('realize', lambda *_: w.input_shape_combine_region(cairo.Region()))
        if not app.hidden and not app.locked: w.show_all()

    def petal(self, x, y, vx=0.0, vy=None):
        if self.kind == 'leaves':                              # ..., shape, flutter phase, how much the wind takes it
            i = random.choices((0, 1, 2), (5, 2, 4))[0]
            return [x, y, vx, vy if vy is not None else random.uniform(30, 60), random.uniform(0, 6.3), random.uniform(-2, 2),
                    random.choice(LEAVES[i][1]), random.uniform(11, 17), i, random.uniform(0, 6.3), random.uniform(.7, 1.3)]
        return [x, y, vx, vy if vy is not None else random.uniform(35, 80), random.uniform(0, 6.3), random.uniform(-3, 3),
                random.choice(PETALS), random.uniform(5, 9), None, 0.0, 1.0]

    def blow(self, dt):
        """the wind: a light prevailing breeze, and every few seconds a gust (rise, hold, die away)"""
        if self.kind != 'leaves': return
        if self.gust is None and random.random() < dt / 7:
            self.gust = [0.0, random.uniform(1, 3), self.prevail * random.uniform(140, 340) * (1 if random.random() < .85 else -.6)]
        target = self.prevail * 18
        if self.gust:
            g = self.gust; g[0] += dt; u = g[0]
            k = min(1, u / 1.2) if u < 1.2 + g[1] else max(0, 1 - (u - 1.2 - g[1]) / 2.2)
            target += g[2] * k
            if u > 1.2 + g[1] + 2.2: self.gust = None
        self.wind += (target - self.wind) * min(1, 2.5 * dt)

    def tick(self, dt, surfaces, fl, chibis):
        self.t += dt
        self.blow(dt)
        leaves = self.kind == 'leaves'
        if len(self.falling) < (90 if leaves else 140) and random.random() < (14 if leaves else 32) * dt:
            if leaves and abs(self.wind) > 120 and random.random() < .5:       # in a gust they come in from upwind too
                self.falling.append(self.petal(-12 if self.wind > 0 else self.W + 12, random.uniform(0, self.H * .6), self.wind))
            else: self.falling.append(self.petal(random.uniform(0, self.W), -14))
        S = {sf.id: sf for sf in surfaces}
        # piles on windows that moved, closed or got covered slide off
        for sid in list(self.piles):
            if sid is None: continue
            sf = S.get(sid); x0y = self.tops.get(sid)
            if sf is None or x0y is None or abs(sf.x0 - x0y[0]) > 2 or abs(sf.y - x0y[1]) > 2:
                vx = (sf.x0 - x0y[0]) * 8 if (sf and x0y) else 0          # moved, closed or covered: the drift slides off
                for (dx, yy, rot, col, shp) in self.piles.pop(sid):
                    if x0y is None: continue
                    self.falling.append([x0y[0] + dx, x0y[1] + yy, vx + random.uniform(-70, 70), random.uniform(-90, 10),
                                         rot, random.uniform(-6, 6), col, 7 if shp is None else 11, shp, 0.0, 1.0])
        for sf in surfaces: self.tops[sf.id] = (sf.x0, sf.y)
        # haikus running through a drift kick it up
        for c in chibis:
            if not c.state.startswith('run'): continue
            key = c.on if c.on is not None and c.on in S else None
            pile = self.piles.get(key); base = S[key].x0 if key in S else 0
            if not pile: continue
            keep = []
            for q in pile:
                if abs(base + q[0] - c.x) < 18 and random.random() < .3:
                    self.falling.append([base + q[0], c.y + q[1] - 4, random.uniform(-90, 90), random.uniform(-220, -120), q[2], 6, q[3],
                                         7 if q[4] is None else 11, q[4], 0.0, 1.0])
                else: keep.append(q)
            self.piles[key] = keep
        if leaves and abs(self.wind) > 150:                  # a strong gust lifts the drifts back off
            for sid, pile in self.piles.items():
                base = (0, fl + 2) if sid is None else self.tops.get(sid)
                if not base or not pile: continue
                n = sum(1 for _ in range(len(pile)) if random.random() < dt * (abs(self.wind) - 150) / 900)
                for _ in range(min(n, 6)):
                    q = pile.pop(random.randrange(len(pile)))
                    self.falling.append([base[0] + q[0], base[1] + q[1] - 3, self.wind * random.uniform(.3, .8), random.uniform(-160, -50),
                                         q[2], random.uniform(-8, 8), q[3], 11, q[4], random.uniform(0, 6.3), random.uniform(.8, 1.3)])
        nxt = []
        for p in self.falling:
            x0, y0 = p[0], p[1]
            if leaves:                                       # flutter: rock side to side while falling, tumble in the wind
                p[9] += (2.2 + abs(self.wind) / 90) * dt
                if p[3] < 30: p[3] = min(p[3] + 200 * dt, random.uniform(35, 70))
                p[2] += (self.wind * p[10] - p[2]) * min(1, 1.6 * dt)
                p[0] += (p[2] + 38 * math.cos(p[9])) * dt; p[1] += (p[3] * (.75 + .5 * abs(math.sin(p[9])))) * dt
                p[5] += (self.wind / 60 * p[10] - p[5]) * min(1, dt)
                p[4] += (p[5] + 1.4 * math.cos(p[9])) * dt
            else:
                if p[3] < 35: p[3] = min(p[3] + 260 * dt, random.uniform(40, 110))
                p[0] += (p[2] + 22 * math.sin(self.t * .9 + p[4])) * dt; p[1] += p[3] * dt; p[4] += p[5] * dt
                p[2] *= (1 - .8 * dt)
            landed = False
            for sf in surfaces:
                if y0 <= sf.y <= p[1] and sf.stands(p[0], 0):
                    pile = self.piles.setdefault(sf.id, [])
                    h = sum(1 for q in pile if abs(q[0] - (p[0] - sf.x0)) < 5)
                    pile.append([p[0] - sf.x0, -(2.4 if leaves else 1.6) * h - 1, p[4], p[6], p[8]]); landed = True
                    if len(pile) > 260: pile.pop(0)
                    break
            if not landed and p[1] >= fl + 2:
                pile = self.piles.setdefault(None, []); h = sum(1 for q in pile if abs(q[0] - p[0]) < 5)
                pile.append([p[0], -(2.4 if leaves else 1.6) * min(h, 8) - 1, p[4], p[6], p[8]]); landed = True
                if len(pile) > 500: pile.pop(0)
            if not landed and -40 < p[0] < self.W + 40 and p[1] > -300: nxt.append(p)
        self.falling = nxt
        self.fl = fl
        self.win.queue_draw()

    def draw(self, w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE); cr.set_source_rgba(0, 0, 0, 0); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER)
        def one(x, y, rot, col, r=7, flat=None, shp=None, ph=0.0):
            if shp is not None: return leaf(x, y, rot, col, r, flat, shp, ph)
            cr.save(); cr.translate(x, y); cr.rotate(rot); cr.scale(1, flat if flat is not None else .35 + .65 * abs(math.cos(rot * 1.7)))
            cr.arc(0, 0, r * .55, 0, 6.3); cr.restore()
            cr.set_source_rgba(*col, .92); cr.fill()

        def leaf(x, y, rot, col, r, flat, shp, ph):
            cr.save(); cr.translate(x, y); cr.rotate(rot)
            fy = flat if flat is not None else math.cos(ph * .5)                # tumbling: the leaf turns edge-on and over
            back = fy < 0; fy = max(.18, abs(fy)); cr.scale(r, r * fy)
            cr.new_path()
            if shp == 0:                                       # maple: five pointed lobes
                for k in range(10):
                    a = -math.pi / 2 + k * math.pi / 5; rr = (1.0, .42)[k % 2] * (.8 if k in (4, 6) else 1)
                    cr.line_to(rr * math.cos(a), rr * math.sin(a))
                cr.close_path()
            elif shp == 1:                                     # ginkgo: a fan with a notch
                cr.move_to(0, .55); cr.arc_negative(0, .55, 1.15, -math.pi * .2, -math.pi * .8); cr.line_to(0, .55)
                cr.close_path()
            else:                                              # aspen / birch: a pointed oval
                cr.move_to(0, -1); cr.curve_to(.75, -.55, .7, .45, 0, .8); cr.curve_to(-.7, .45, -.75, -.55, 0, -1); cr.close_path()
            k = .78 if back else 1.0
            cr.set_source_rgba(col[0] * k, col[1] * k, col[2] * k, .95); cr.fill()
            cr.set_line_width(.09); cr.set_source_rgba(col[0] * .55, col[1] * .5, col[2] * .45, .8)
            cr.move_to(0, .9 if shp != 1 else 1.05); cr.line_to(0, -.55 if shp != 1 else -.3); cr.stroke()   # stem and midrib
            cr.restore()
        for p in self.falling: one(p[0], p[1], p[4], p[6], p[7], None, p[8], p[9])
        for sid, pile in self.piles.items():
            base = (self.tops.get(sid) or (0, getattr(self, 'fl', self.H)))
            bx, by = (0, getattr(self, 'fl', self.H) + 2) if sid is None else base
            for (dx, yy, rot, col, shp) in pile: one(bx + dx, by + yy, rot, col, 7 if shp is None else 10, .4, shp)
        return True


