PROGRAMME = os.path.expanduser('~/.config/ohaiku/programme.txt')
PROGRAMME_DEFAULT = """# Haiku Theater 3000's programme. One per line: a video file, a folder (every video in it), or a URL (streamed
# with yt-dlp). Played muted, in random order. You can also drag a video onto the theater window to put it on next.
~/Videos
